---
// CTA pair for compare pages. These pages are paid-ad landing surfaces: the trial
// button must exist above the fold and again mid-page, not only in the closing
// banner. Buttons keep config.signupUrl so the Layout attribution passthrough
// rewrites them with stored UTM/fbclid params.
import { config } from '../config';

type Props = {
  secondaryHref?: string;
  secondaryLabel?: string;
};

const { secondaryHref = '#comparison', secondaryLabel = 'See the comparison' } = Astro.props;
---

<div class="flex flex-col sm:flex-row items-center justify-center gap-3">
  <a
    href={config.signupUrl}
    class="inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
  >
    Start free trial
  </a>
  <a
    href={secondaryHref}
    class="inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm hover:border-brand-300 hover:text-brand-700 transition-colors"
  >
    {secondaryLabel}
  </a>
</div>
<p class="mt-3 text-center text-sm text-slate-500">
  $79/month flat · 14-day free trial · No credit card required
</p>
