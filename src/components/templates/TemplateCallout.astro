---
// "Prefer paper for now?" strip for feature pages: links the free templates
// that cover the same workflow, so every money page feeds the template hub
// and every template page's feature funnel is reciprocal. An optional default
// slot renders one line of extra links under the grid (the homepage uses it
// for the pay app builder, the compare hub and the blog).
import { TEMPLATES, type TemplateSlug } from '../../data/templates';

interface Props {
  slugs: TemplateSlug[];
  heading?: string;
  class?: string;
}

const {
  slugs,
  heading = 'Not ready for software? Start with the free templates',
  class: className = 'mb-20',
} = Astro.props;

const items = slugs.map((s) => TEMPLATES[s]).filter(Boolean);
---

<section class={`max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 ${className}`}>
  <div class="rounded-2xl border border-slate-200 bg-slate-50 px-6 py-8 sm:px-10">
    <div class="sm:flex sm:items-start sm:justify-between sm:gap-8">
      <div class="max-w-xl">
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">{heading}</h2>
        <p class="mt-2 text-sm text-slate-500 leading-relaxed">
          The same documents BuildWorkPro generates, as free fillable PDF, Excel and Word templates
          — no email required.
        </p>
      </div>
      <a
        href="/templates/"
        class="mt-4 sm:mt-0 inline-flex shrink-0 items-center text-sm font-semibold text-brand-600 hover:text-brand-700"
      >
        All free templates <span aria-hidden="true" class="ml-1">→</span>
      </a>
    </div>
    <ul class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {
        items.map((t) => (
          <li>
            <a
              href={`/templates/${t.slug}/`}
              class="group flex items-start gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 hover:border-brand-300 hover:shadow-sm transition-all"
            >
              <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12h6m-6 4h6M7 4h7l5 5v11a1 1 0 01-1 1H7a1 1 0 01-1-1V5a1 1 0 011-1z"
                  />
                </svg>
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-slate-900 group-hover:text-brand-700">
                  {t.title}
                </span>
                <span class="block text-xs text-slate-500 mt-0.5">{t.formats.join(' · ')}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    {
      Astro.slots.has('default') && (
        <p class="mt-6 text-sm text-slate-500 leading-relaxed">
          <slot />
        </p>
      )
    }
  </div>
</section>
