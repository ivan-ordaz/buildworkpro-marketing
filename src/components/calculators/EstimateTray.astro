---
// The estimate tray under every calculator. Lines are kept in this browser
// (localStorage, src/lib/calculators/estimate.ts) and shared across all the
// calculators, so a contractor can add a room on the drywall page and a run of
// fence on the fence page and see one estimate. Behavior: lib/calculators/tray.ts.
import { config } from '../../config';

interface Props {
  /** Calculator slug, used only to tag analytics events. */
  tool: string;
}

const { tool } = Astro.props;
const btn =
  'inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-800 hover:border-brand-300 hover:text-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500';
---

<section
  data-estimate-tray
  data-tool={tool}
  aria-labelledby="tray-heading"
  class="rounded-2xl border border-brand-200 bg-slate-50 p-5 sm:p-6"
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 id="tray-heading" class="text-lg font-semibold text-slate-900">Your estimate</h2>
      <p class="text-sm text-slate-500">
        Saved in this browser. Add rooms or runs from any of our calculators.
      </p>
    </div>
    <span
      data-tray-count
      class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">0 lines</span
    >
  </div>

  <p
    data-tray-empty
    class="mt-4 rounded-xl border border-dashed border-slate-300 bg-white p-5 text-sm text-slate-500"
  >
    Nothing here yet. Run the numbers above and press “Add to estimate”.
  </p>

  <div data-tray-body hidden class="mt-4 space-y-3">
    <div data-tray-list class="space-y-3"></div>
    <div
      class="flex flex-wrap items-baseline justify-between gap-3 border-t-2 border-slate-900 pt-3"
    >
      <span class="text-base font-semibold text-slate-900">Estimate total</span>
      <span data-tray-total class="text-xl font-bold tabular-nums text-slate-900">$0.00</span>
    </div>
    <p data-tray-unpriced class="text-xs text-slate-500"></p>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" data-tray-action="copy" class={btn}>Copy as text</button>
      <button type="button" data-tray-action="csv" class={btn}>Download CSV</button>
      <button
        type="button"
        data-tray-action="clear"
        class="inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500"
        >Clear</button
      >
      <span data-tray-note class="text-sm text-slate-500" aria-live="polite"></span>
    </div>
    <div class="rounded-xl border border-brand-200 bg-white p-4">
      <p class="text-sm font-semibold text-slate-900">Ready to send this as a proposal?</p>
      <p class="mt-1 text-sm text-slate-600">
        BuildWorkPro builds bids from line items like these, with your margin and overhead, and
        turns them into a PDF proposal. $79/mo flat, free for 14 days.
      </p>
      <a
        href={config.signupUrl}
        data-tray-action="signup"
        class="mt-3 inline-flex items-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
      >
        Start free trial
      </a>
    </div>
  </div>
</section>

<script>
  import { mountTray } from '../../lib/calculators/tray';
  for (const el of document.querySelectorAll<HTMLElement>('[data-estimate-tray]')) {
    mountTray(el, el.dataset.tool ?? 'calculator');
  }
</script>
