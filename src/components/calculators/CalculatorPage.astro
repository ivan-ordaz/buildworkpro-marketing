---
// Shared shell for the trade calculators under /tools/: hero, the calculator
// itself (default slot), the shared estimate tray, a "how it's calculated"
// section (named slot "method") so the formulas are on the page, related links
// and an FAQ with FAQPage JSON-LD. Plan: calculators + price index, 2026-10-08.
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import FAQSection from '../FAQSection.astro';
import EstimateTray from './EstimateTray.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string;
  /** Calculator slug, e.g. "drywall-calculator". */
  tool: string;
  chips?: string[];
  faqs: { question: string; answer: string }[];
  related?: { href: string; label: string; note: string }[];
}

const { title, description, h1, intro, tool, chips = [], faqs, related = [] } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: h1,
  url: new URL(Astro.url.pathname, Astro.site).href,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any (web browser)',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'BuildWorkPro', url: Astro.site?.href },
};
---

<Layout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header />
  <main class="pt-28 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 text-center">
      <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
        Free calculator
      </p>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
        {h1}
      </h1>
      <p class="mt-5 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">{intro}</p>
      {
        chips.length > 0 && (
          <ul class="mt-6 flex flex-wrap justify-center gap-2 text-xs font-medium text-slate-600">
            {chips.map((c) => (
              <li class="rounded-full border border-slate-200 bg-white px-3 py-1">{c}</li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-8" aria-label={h1}>
      <slot />
    </section>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <EstimateTray tool={tool} />
    </div>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl font-bold text-slate-900">How it’s calculated</h2>
      <div
        class="prose prose-slate mt-4 max-w-none prose-p:text-slate-600 prose-li:text-slate-600 prose-a:text-brand-700"
      >
        <slot name="method" />
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
          <h2 class="text-2xl font-bold text-slate-900 text-center">Keep going</h2>
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            {related.map((r) => (
              <a
                href={r.href}
                class="block rounded-2xl border border-slate-200 bg-white p-5 hover:border-brand-300 hover:shadow-sm"
              >
                <span class="block font-semibold text-slate-900">{r.label}</span>
                <span class="mt-1 block text-sm text-slate-600">{r.note}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <FAQSection faqs={faqs} />
    </div>
  </main>
  <Footer />
</Layout>
