---
// Responsive comparison for the three compare pages. The previous inline
// <table class="min-w-[640px]"> clipped the entire competitor column off-screen
// at phone widths with no scroll affordance — on the pages Meta ads land on.
// md and up keeps the classic table; below md each criterion renders as a
// stacked card so both columns are always visible.

type Row = {
  label: string;
  bwp: string;
  other: string;
  bwpWins: boolean;
};

type Props = {
  rows: Row[];
  competitor: string;
};

const { rows, competitor } = Astro.props;
---

<!-- Desktop / tablet -->
<div class="hidden md:block rounded-2xl border border-slate-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="bg-slate-50">
        <th class="text-left px-6 py-4 font-semibold text-slate-900 w-1/3"></th>
        <th class="text-left px-6 py-4 font-semibold text-brand-600">BuildWorkPro</th>
        <th class="text-left px-6 py-4 font-semibold text-slate-500">{competitor}</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {
        rows.map((row, i) => (
          <tr class={i % 2 === 1 ? 'bg-slate-50/50' : ''}>
            <td class="px-6 py-4 font-medium text-slate-700">{row.label}</td>
            <td
              class={`px-6 py-4 ${row.bwpWins ? 'font-semibold text-brand-700' : 'text-slate-600'}`}
            >
              {row.bwp}
            </td>
            <td class="px-6 py-4 text-slate-500">{row.other}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<!-- Mobile: stacked per-criterion cards -->
<div class="md:hidden space-y-3">
  {
    rows.map((row) => (
      <div class="rounded-xl border border-slate-200 overflow-hidden">
        <div class="bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700">{row.label}</div>
        <div class="px-4 py-3 border-b border-slate-100">
          <div class="text-xs font-semibold uppercase tracking-wide text-brand-600 mb-0.5">
            BuildWorkPro
          </div>
          <div class={`text-sm ${row.bwpWins ? 'font-semibold text-brand-700' : 'text-slate-600'}`}>
            {row.bwp}
          </div>
        </div>
        <div class="px-4 py-3">
          <div class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-0.5">
            {competitor}
          </div>
          <div class="text-sm text-slate-500">{row.other}</div>
        </div>
      </div>
    ))
  }
</div>
