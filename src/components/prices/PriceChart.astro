---
// Server-rendered line chart for one PPI series, rebased to 100 at the start
// of the window. One SVG per range, toggled by buttons, so the chart needs no
// client-side math and reads the same to a crawler. Geometry: lib/prices/ppi.ts.
import { chartGeometry, monthLabel, rebased, type Point } from '../../lib/prices/ppi';

interface Props {
  id: string;
  name: string;
  asOf?: string;
  /** Ranges in months; the first is shown by default. */
  ranges?: { months: number; label: string }[];
}

const {
  id,
  name,
  asOf,
  ranges = [
    { months: 24, label: '2 years' },
    { months: 60, label: '5 years' },
    { months: 120, label: '10 years' },
  ],
} = Astro.props;

const charts = ranges
  .map((r) => {
    const pts: Point[] = rebased(id, r.months, asOf);
    return { ...r, pts, geo: pts.length > 1 ? chartGeometry(pts) : null };
  })
  .filter((c) => c.geo);
const uid = `chart-${id}`;
---

<figure class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5" data-price-chart={uid}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <figcaption class="text-sm text-slate-600">
      {name}, producer price index rebased to 100
    </figcaption>
    <div class="flex gap-1.5" role="group" aria-label="Chart range">
      {
        charts.map((c, i) => (
          <button
            type="button"
            data-range={c.months}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600 aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-white focus:outline-none focus:ring-2 focus:ring-brand-500"
          >
            {c.label}
          </button>
        ))
      }
    </div>
  </div>
  {
    charts.map((c, i) => {
      const g = c.geo!;
      const first = c.pts[0][0];
      return (
        <div data-range-panel={c.months} hidden={i !== 0} class="mt-3">
          <svg
            viewBox={`0 0 ${g.width} ${g.height}`}
            class="block h-auto w-full"
            role="img"
            aria-label={`${name}, ${monthLabel(first)} to ${monthLabel(c.pts.at(-1)![0])}, ${monthLabel(first)} = 100, now ${g.end.value.toFixed(1)}`}
          >
            {g.ticks.map((t) => (
              <g>
                <line
                  x1="44"
                  x2={g.width - 56}
                  y1={t.y}
                  y2={t.y}
                  stroke="#e2e8f0"
                  stroke-width="1"
                />
                <text x="38" y={t.y + 4} text-anchor="end" font-size="11" fill="#64748b">
                  {t.value}
                </text>
              </g>
            ))}
            {g.xLabels.map((l) => (
              <text x={l.x} y={g.height - 6} text-anchor="middle" font-size="11" fill="#64748b">
                {l.label}
              </text>
            ))}
            {g.area && <path d={g.area} fill="#dbeafe" opacity="0.7" />}
            <path
              d={g.path}
              fill="none"
              stroke="#2563eb"
              stroke-width="2.25"
              stroke-linejoin="round"
            />
            <circle
              cx={g.end.x}
              cy={g.end.y}
              r="4.5"
              fill="#2563eb"
              stroke="#fff"
              stroke-width="2"
            />
            <text x={g.end.x + 8} y={g.end.y + 4} font-size="12" font-weight="600" fill="#0f172a">
              {g.end.value.toFixed(1)}
            </text>
          </svg>
          <p class="mt-1 text-xs text-slate-500">
            {monthLabel(first)} = 100. A reading of 110 means prices were 10% higher than in{' '}
            {monthLabel(first)}.
          </p>
        </div>
      );
    })
  }
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-price-chart]')) {
    const buttons = Array.from(fig.querySelectorAll<HTMLButtonElement>('[data-range]'));
    const panels = Array.from(fig.querySelectorAll<HTMLElement>('[data-range-panel]'));
    for (const b of buttons) {
      b.addEventListener('click', () => {
        for (const o of buttons) o.setAttribute('aria-pressed', String(o === b));
        for (const p of panels) p.hidden = p.dataset.rangePanel !== b.dataset.range;
      });
    }
  }
</script>
