---
import { config } from '../config';
import { TEMPLATE_LIST } from '../data/templates';
import { TOOLS } from '../data/tools';
import { monthLabel, reportMonths } from '../lib/prices/ppi';

const features = [
  { label: 'AI Agents (Claude, ChatGPT, Grok Bot)', href: '/agents/' },
  { label: 'Bidding & Estimating', href: '/features/construction-bidding/' },
  { label: 'Pay Applications', href: '/features/pay-applications/' },
  { label: 'Change Orders', href: '/features/change-orders/' },
  { label: 'Project Management', href: '/features/project-management/' },
  { label: 'Site Logs', href: '/features/site-logs/' },
  { label: 'Time Tracking', href: '/features/time-tracking/' },
  { label: 'CRM & Pipeline', href: '/features/construction-crm/' },
  { label: 'Reports & Analytics', href: '/features/reports/' },
];

const solutions = [
  { label: 'Glazing Contractors', href: '/solutions/glazing-contractors/' },
  { label: 'HVAC Contractors', href: '/solutions/hvac-contractors/' },
  { label: 'Electrical Contractors', href: '/solutions/electrical-contractors/' },
  { label: 'Plumbing Contractors', href: '/solutions/plumbing-contractors/' },
  { label: 'Concrete Contractors', href: '/solutions/concrete-contractors/' },
  { label: 'Roofing Contractors', href: '/solutions/roofing-contractors/' },
  { label: 'Framing Contractors', href: '/solutions/framing-contractors/' },
];

const compare = [
  { label: 'vs Procore', href: '/compare/procore-alternative/' },
  { label: 'vs Buildertrend', href: '/compare/buildertrend-alternative/' },
  { label: 'vs Contractor Foreman', href: '/compare/contractor-foreman-alternative/' },
  { label: 'vs JobTread', href: '/compare/jobtread-alternative/' },
  { label: 'vs Knowify', href: '/compare/knowify-alternative/' },
];

// "Resources" menu: the free templates, tools and material price pages. The
// counts and the latest report month come from the registries, so the menu
// never goes stale. The phone menu shows the first two links of each group.
const latestReport = reportMonths()[0];
const resources = [
  {
    title: 'Templates',
    links: [
      { label: 'Pay application (G702/G703 style)', href: '/templates/aia-g702-g703/' },
      { label: 'Change order', href: '/templates/change-order/' },
      { label: 'Construction estimate', href: '/templates/construction-estimate/' },
      { label: 'Lien waiver', href: '/templates/lien-waiver/' },
      { label: 'Daily report', href: '/templates/daily-report/' },
    ],
    all: { label: `All ${TEMPLATE_LIST.length} templates`, href: '/templates/' },
  },
  {
    title: 'Free tools',
    links: [
      { label: 'Voltage drop calculator', href: '/tools/voltage-drop-calculator/' },
      { label: 'Markup vs margin calculator', href: '/tools/markup-vs-margin-calculator/' },
      { label: 'Conduit fill calculator', href: '/tools/conduit-fill-calculator/' },
      { label: 'Drywall calculator', href: '/tools/drywall-calculator/' },
      { label: 'Pay app builder', href: '/tools/pay-app/' },
    ],
    all: { label: `All ${TOOLS.length} tools`, href: '/tools/' },
  },
  {
    title: 'Material prices',
    links: [
      { label: 'Lumber', href: '/prices/lumber/' },
      { label: 'Copper wire', href: '/prices/copper-wire/' },
      { label: 'Concrete', href: '/prices/concrete/' },
      { label: 'Steel and rebar', href: '/prices/steel/' },
      { label: `${monthLabel(latestReport)} report`, href: `/prices/reports/${latestReport}/` },
    ],
    all: { label: 'All material prices', href: '/prices/' },
  },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center group">
        <picture>
          <source
            type="image/webp"
            srcset="/logo-190.webp 190w, /logo-380.webp 380w"
            sizes="(min-width: 1280px) 193px, 177px"
          />
          <img
            src="/logo.png"
            alt="BuildWorkPro"
            width="950"
            height="236"
            class="h-11 xl:h-12 w-auto"
            decoding="async"
          />
        </picture>
      </a>

      <!-- Desktop Nav. lg:, not md:: at exactly 768px the full nav (5 items + Log in
           + CTA + 180px logo) cannot fit — "Log in" wraps into "Blog" on iPad portrait.
           From 1024 to 1279px the bar is just as tight: items sit 20px apart, the logo
           stays at its phone size, the trial button is 16px narrower, and neither it nor
           "Log in" wraps. From xl up: 32px gaps and the full logo.
           tests/header-resources.spec.ts checks the fit at 1024, 1280 and 1440. -->
      <nav class="hidden lg:flex items-center gap-5 xl:gap-8" aria-label="Primary">
        <a
          href="/agents/"
          class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors"
        >
          Agents
        </a>

        <!-- Features dropdown -->
        <div class="relative group/menu">
          <button
            type="button"
            class="flex items-center gap-1 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors py-2"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Features
            <svg
              class="w-4 h-4 transition-transform group-hover/menu:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div
            class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible group-focus-within/menu:opacity-100 group-focus-within/menu:visible transition-all duration-150 z-50"
          >
            <div
              class="w-64 bg-white border border-slate-100 rounded-xl shadow-xl py-2"
              role="menu"
            >
              {
                features.map((item) => (
                  <a
                    href={item.href}
                    class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-brand-600 transition-colors"
                    role="menuitem"
                  >
                    {item.label}
                  </a>
                ))
              }
              <div class="border-t border-slate-100 mt-2 pt-2">
                <a
                  href="/features/"
                  class="flex items-center justify-between px-4 py-2 text-sm font-semibold text-brand-600 hover:bg-brand-50 transition-colors"
                  role="menuitem"
                >
                  View all features
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Solutions dropdown -->
        <div class="relative group/menu">
          <button
            type="button"
            class="flex items-center gap-1 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors py-2"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Solutions
            <svg
              class="w-4 h-4 transition-transform group-hover/menu:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div
            class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible group-focus-within/menu:opacity-100 group-focus-within/menu:visible transition-all duration-150 z-50"
          >
            <div
              class="w-64 bg-white border border-slate-100 rounded-xl shadow-xl py-2"
              role="menu"
            >
              {
                solutions.map((item) => (
                  <a
                    href={item.href}
                    class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-brand-600 transition-colors"
                    role="menuitem"
                  >
                    {item.label}
                  </a>
                ))
              }
              <div class="border-t border-slate-100 mt-2 pt-2">
                <a
                  href="/solutions/"
                  class="flex items-center justify-between px-4 py-2 text-sm font-semibold text-brand-600 hover:bg-brand-50 transition-colors"
                  role="menuitem"
                >
                  View all solutions
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Compare dropdown -->
        <div class="relative group/menu">
          <button
            type="button"
            class="flex items-center gap-1 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors py-2"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Compare
            <svg
              class="w-4 h-4 transition-transform group-hover/menu:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div
            class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible group-focus-within/menu:opacity-100 group-focus-within/menu:visible transition-all duration-150 z-50"
          >
            <div
              class="w-56 bg-white border border-slate-100 rounded-xl shadow-xl py-2"
              role="menu"
            >
              {
                compare.map((item) => (
                  <a
                    href={item.href}
                    class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-brand-600 transition-colors"
                    role="menuitem"
                  >
                    {item.label}
                  </a>
                ))
              }
              <div class="border-t border-slate-100 mt-2 pt-2">
                <a
                  href="/compare/"
                  class="flex items-center justify-between px-4 py-2 text-sm font-semibold text-brand-600 hover:bg-brand-50 transition-colors"
                  role="menuitem"
                >
                  All comparisons
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <a
          href="/pricing/"
          class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors"
        >
          Pricing
        </a>
        <a
          href="/blog/"
          class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors"
        >
          Blog
        </a>
        <!-- Resources dropdown: templates, tools and material prices. The last item, so
             the panel is anchored to its right edge and opens toward the page. -->
        <div class="relative group/menu" data-resources-menu>
          <button
            type="button"
            class="flex items-center gap-1 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors py-2"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Resources
            <svg
              class="w-4 h-4 transition-transform group-hover/menu:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div
            class="absolute right-0 top-full pt-2 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible group-focus-within/menu:opacity-100 group-focus-within/menu:visible transition-all duration-150 z-50"
          >
            <div class="w-[44rem] bg-white border border-slate-100 rounded-xl shadow-xl p-4">
              <div class="grid grid-cols-3 gap-x-4">
                {
                  resources.map((group) => (
                    <div>
                      <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">
                        {group.title}
                      </p>
                      {group.links.map((item) => (
                        <a
                          href={item.href}
                          class="block px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-slate-50 hover:text-brand-600 transition-colors"
                        >
                          {item.label}
                        </a>
                      ))}
                      <a
                        href={group.all.href}
                        class="mt-1 flex items-center justify-between px-3 py-2 rounded-lg text-sm font-semibold text-brand-600 hover:bg-brand-50 transition-colors"
                      >
                        {group.all.label}
                        <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  ))
                }
              </div>
              <p class="mt-3 border-t border-slate-100 px-3 pt-3 text-xs text-slate-500">
                Free, no email required. Material prices are updated monthly from Bureau of Labor
                Statistics data.
              </p>
            </div>
          </div>
        </div>
      </nav>

      <!-- CTA Buttons -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href={config.loginUrl}
          class="whitespace-nowrap text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors"
        >
          Log in
        </a>
        <a
          href={config.signupUrl}
          class="whitespace-nowrap text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 px-4 xl:px-5 py-2.5 rounded-lg transition-all hover:-translate-y-0.5"
        >
          Start free trial
        </a>
      </div>

      <!-- Below lg the trial CTA must stay visible in the bar itself — paid mobile
           traffic previously saw no CTA anywhere without opening the hamburger. -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={config.signupUrl}
          class="text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 px-3.5 py-2 rounded-lg transition-colors whitespace-nowrap"
        >
          Start free trial
        </a>
        <button
          id="mobile-menu-btn"
          class="p-2 text-slate-600 hover:text-slate-900"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              id="menu-icon"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-white border-t border-slate-100 shadow-lg max-h-[calc(100vh-4rem)] overflow-y-auto"
  >
    <div class="px-4 py-4 space-y-1">
      <a href="/agents/" class="block py-3 text-sm font-medium text-slate-700 hover:text-brand-600">
        Agents
      </a>

      <!-- Features accordion -->
      <details class="group">
        <summary
          class="flex items-center justify-between text-sm font-medium text-slate-700 py-3 cursor-pointer list-none"
        >
          <span>Features</span>
          <svg
            class="w-4 h-4 transition-transform group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <div class="pl-3 pb-2 space-y-1">
          {
            features.map((item) => (
              <a href={item.href} class="block py-2 text-sm text-slate-600 hover:text-brand-600">
                {item.label}
              </a>
            ))
          }
          <a
            href="/features/"
            class="block py-2 text-sm font-semibold text-brand-600 hover:text-brand-700"
          >
            View all features →
          </a>
        </div>
      </details>

      <!-- Solutions accordion -->
      <details class="group">
        <summary
          class="flex items-center justify-between text-sm font-medium text-slate-700 py-3 cursor-pointer list-none"
        >
          <span>Solutions</span>
          <svg
            class="w-4 h-4 transition-transform group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <div class="pl-3 pb-2 space-y-1">
          {
            solutions.map((item) => (
              <a href={item.href} class="block py-2 text-sm text-slate-600 hover:text-brand-600">
                {item.label}
              </a>
            ))
          }
          <a
            href="/solutions/"
            class="block py-2 text-sm font-semibold text-brand-600 hover:text-brand-700"
          >
            View all solutions →
          </a>
        </div>
      </details>

      <!-- Compare accordion -->
      <details class="group">
        <summary
          class="flex items-center justify-between text-sm font-medium text-slate-700 py-3 cursor-pointer list-none"
        >
          <span>Compare</span>
          <svg
            class="w-4 h-4 transition-transform group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <div class="pl-3 pb-2 space-y-1">
          {
            compare.map((item) => (
              <a href={item.href} class="block py-2 text-sm text-slate-600 hover:text-brand-600">
                {item.label}
              </a>
            ))
          }
          <a
            href="/compare/"
            class="block py-2 text-sm font-semibold text-brand-600 hover:text-brand-700"
          >
            All comparisons →
          </a>
        </div>
      </details>

      <a
        href="/pricing/"
        class="block py-3 text-sm font-medium text-slate-700 hover:text-brand-600"
      >
        Pricing
      </a>
      <a href="/blog/" class="block py-3 text-sm font-medium text-slate-700 hover:text-brand-600">
        Blog
      </a>
      <!-- Resources accordion -->
      <details class="group" data-resources-mobile>
        <summary
          class="flex items-center justify-between text-sm font-medium text-slate-700 py-3 cursor-pointer list-none"
        >
          <span>Resources</span>
          <svg
            class="w-4 h-4 transition-transform group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <div class="pl-3 pb-2 space-y-1">
          {
            resources.map((group) => (
              <>
                <p class="pt-2 text-xs font-semibold uppercase tracking-wide text-slate-400">
                  {group.title}
                </p>
                {group.links.slice(0, 2).map((item) => (
                  <a
                    href={item.href}
                    class="block py-2 text-sm text-slate-600 hover:text-brand-600"
                  >
                    {item.label}
                  </a>
                ))}
                <a
                  href={group.all.href}
                  class="block py-2 text-sm font-semibold text-brand-600 hover:text-brand-700"
                >
                  {group.all.label} →
                </a>
              </>
            ))
          }
        </div>
      </details>

      <div class="pt-3 border-t border-slate-100 space-y-2">
        <a
          href={config.loginUrl}
          class="block w-full text-center text-sm font-medium text-slate-700 hover:text-brand-600 py-2.5"
        >
          Log in
        </a>
        <a
          href={config.signupUrl}
          class="block w-full text-center text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 px-5 py-2.5 rounded-lg transition-all"
        >
          Start free trial
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const mobileMenuBtn = document.getElementById('mobile-menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;

  // Sticky header background
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
    } else {
      header.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
    }
  });

  // Mobile menu toggle
  mobileMenuBtn.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.toggle('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', String(isOpen));
  });

  // Close mobile menu on link click (but not on accordion summary clicks)
  mobileMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
    });
  });
</script>
