---
// Organic bet: GSC 2026-08-16 → 2026-09-12 showed a new query
// "buildertrend alternative" landing here (~41 impressions, avg pos ~36, 0 clicks).
// Title / H1 / meta lead with that intent. Pricing figures stay last-published /
// independently reported — same caveats as /blog/buildertrend-pricing/. Do not
// invent current quote amounts, testimonials, or FL/NOA numbers.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import Screenshot from '../../components/Screenshot.astro';
import CompareCta from '../../components/CompareCta.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { config } from '../../config';

const comparisonRows = [
  {
    label: 'Built for',
    bwp: 'Trade subcontractors working for GCs',
    other: 'Home builders & remodelers selling to homeowners',
    bwpWins: true,
  },
  {
    label: 'Pricing',
    bwp: '$79/month flat, published',
    other: 'Custom quote based on volume (historically ~$339–$499+/month entry)*',
    bwpWins: true,
  },
  {
    label: 'How you buy',
    bwp: 'Self-serve signup, 14-day free trial',
    other: 'Demo and quote process — no self-serve trial',
    bwpWins: true,
  },
  {
    label: 'Users',
    bwp: 'Unlimited',
    other: 'Unlimited',
    bwpWins: false,
  },
  {
    label: 'Progress billing (schedule of values, retainage)',
    bwp: 'Core feature — AIA-style pay applications',
    other: 'Oriented to residential invoicing and draws',
    bwpWins: true,
  },
  {
    label: 'Bidding for subs',
    bwp: 'Line items, labor rates, markup, PDF proposals to GCs',
    other: 'Proposals oriented to homeowner clients',
    bwpWins: true,
  },
  {
    label: 'Homeowner portal, selections & allowances',
    bwp: 'Not the focus',
    other: 'Industry leader',
    bwpWins: false,
  },
  {
    label: 'Daily logs & time tracking',
    bwp: 'Included',
    other: 'Included',
    bwpWins: false,
  },
  {
    label: 'Sales pipeline & CRM',
    bwp: 'Included — GC and vendor contacts, lead → bid → job',
    other: 'Included — homeowner/client-centric',
    bwpWins: false,
  },
  {
    label: 'Work by chatting with Claude or ChatGPT',
    bwp: 'Included — the assistant builds bids & projects in your account',
    other: 'In-platform AI features; no Claude/ChatGPT connection',
    bwpWins: true,
  },
