---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';

const comparisons = [
  {
    title: 'BuildWorkPro vs Procore',
    description:
      'Procore is built for GCs and owners, with quote-based pricing tied to your construction volume — commonly thousands per year. See where it genuinely wins, and why subs run their own business on BuildWorkPro at $79/month flat.',
    href: '/compare/procore-alternative/',
    competitor: 'Procore',
  },
  {
    title: 'Buildertrend Alternative for Subcontractors',
    description:
      'Looking for a Buildertrend alternative? Buildertrend is for home builders selling to homeowners. If you bill GCs with pay apps, BuildWorkPro is built around that loop at $79/month flat.',
    href: '/compare/buildertrend-alternative/',
    competitor: 'Buildertrend',
  },
  {
    title: 'BuildWorkPro vs Contractor Foreman',
    description:
      'Contractor Foreman is a broad, affordable all-in-one with five tiers for GCs, subs, and trades. BuildWorkPro gives specialty subs every feature and unlimited users on one flat $79/month plan, with depth on bidding and AIA-style pay apps.',
    href: '/compare/contractor-foreman-alternative/',
    competitor: 'Contractor Foreman',
  },
  {
    title: 'JobTread Alternative for Subcontractors',
    description:
      'Looking for a JobTread alternative? JobTread is builder-first, starts at $199/month plus per-user fees, and has no free trial. BuildWorkPro runs the sub-to-GC loop at $79/month flat.',
    href: '/compare/jobtread-alternative/',
    competitor: 'JobTread',
  },
  {
    title: 'BuildWorkPro vs Knowify',
    description:
      'Knowify genuinely gets the trades, but gates real job costing at ~$329/month and charges $29 per user. BuildWorkPro includes job costing, a full CRM, and unlimited users in one flat $79/month plan.',
    href: '/compare/knowify-alternative/',
    competitor: 'Knowify',
  },
];
---

<Layout
  title="BuildWorkPro Alternatives & Comparisons | BuildWorkPro"
  description="See how BuildWorkPro compares to Procore, Buildertrend, and other construction management platforms. Built for subcontractors, priced flat at $79/month."
>
  <Header />
  <main class="pt-32 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">Compare</p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          How BuildWorkPro stacks up
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          Honest comparisons against the platforms subcontractors actually evaluate. No fluff — just
          where each tool fits and where it doesn't.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {
          comparisons.map((cmp) => (
            <a
              href={cmp.href}
              class="group p-8 rounded-2xl border border-slate-100 hover:border-slate-200 bg-white hover:shadow-lg transition-all duration-300"
            >
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-semibold mb-5">
                vs {cmp.competitor}
              </div>
              <h2 class="text-xl font-semibold text-slate-900 mb-3 group-hover:text-brand-600 transition-colors">
                {cmp.title}
              </h2>
              <p class="text-slate-500 leading-relaxed mb-4">{cmp.description}</p>
              <span class="inline-flex items-center text-sm font-medium text-brand-600 group-hover:gap-2 gap-1.5 transition-all">
                Read comparison
                <svg
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      <p class="mt-12 text-center text-slate-500 leading-relaxed max-w-2xl mx-auto">
        Still deciding what kind of tool you need? Read why
        <a
          href="/blog/subcontractor-vs-general-contractor-software/"
          class="text-brand-600 hover:underline">GC software rarely fits a subcontractor</a
        >, what
        <a href="/blog/procore-pricing-for-subcontractors/" class="text-brand-600 hover:underline"
          >Procore actually costs a sub</a
        >, and what
        <a href="/blog/buildertrend-pricing/" class="text-brand-600 hover:underline"
          >Buildertrend's quote-only pricing</a
        > looks like in 2026.
      </p>
    </div>

    <div class="mt-20">
      <CTA />
    </div>
  </main>
  <Footer />
</Layout>
