---
// /tools/ — hub for the free browser tools (calculators, pay app builder).
// Renders from src/data/tools.ts. Before this page existed /tools/ 404'd and
// the breadcrumb builder skipped the segment; see segmentsWithoutHub in Layout.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { TOOLS, TOOL_GROUPS } from '../../data/tools';
---

<Layout
  title="Free Construction Calculators & Tools for Subcontractors | BuildWorkPro"
  description="Free tools for subcontractors: trade calculators that build an estimate as you go and a pay application builder with retainage math. They run in your browser, no email required."
>
  <Header />
  <main class="pt-28 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 text-center">
      <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">Free tools</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
        Free tools for subcontractors
      </h1>
      <p class="mt-5 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
        Calculators that do the takeoff math and add each room or run to one estimate, and a pay
        application builder that rolls forward every month. They run in your browser and save there,
        with no email required.
      </p>
    </section>

    {
      TOOL_GROUPS.map((group) => {
        const items = TOOLS.filter((t) => t.group === group);
        return items.length > 0 ? (
          <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-14" data-tools-group={group}>
            <h2 class="text-xl font-bold text-slate-900">{group}</h2>
            <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((t) => (
                <a
                  href={t.href}
                  data-tool-card
                  class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5 hover:border-brand-300 hover:shadow-sm"
                >
                  <span class="self-start rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">
                    {t.tag}
                  </span>
                  <span class="mt-3 font-semibold text-slate-900">{t.name}</span>
                  <span class="mt-1 text-sm text-slate-600">{t.blurb}</span>
                </a>
              ))}
            </div>
          </section>
        ) : null;
      })
    }

    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
        <h2 class="text-xl font-bold text-slate-900">Prefer a document?</h2>
        <p class="mt-2 text-slate-600">
          The <a href="/templates/" class="font-semibold text-brand-700 hover:underline"
            >free templates library</a
          > has fillable PDF, Excel and Word versions of estimates, change orders, lien waivers, daily
          reports and pay applications, including a
          <a
            href="/templates/drywall-estimate/"
            class="font-semibold text-brand-700 hover:underline">drywall estimate</a
          > that pairs with the
          <a href="/tools/drywall-calculator/" class="font-semibold text-brand-700 hover:underline"
            >drywall calculator</a
          >.
        </p>
        <p class="mt-3 text-slate-600">
          Before you put a material price in a bid, check the
          <a href="/prices/" class="font-semibold text-brand-700 hover:underline"
            >construction material price trends</a
          >: lumber, concrete, steel, copper wire and more, updated monthly from Bureau of Labor
          Statistics data.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
