---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import TemplateCallout from '../../components/templates/TemplateCallout.astro';
import Screenshot from '../../components/Screenshot.astro';
import DemoVideo from '../../components/DemoVideo.astro';
import { config } from '../../config';

const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'BuildWorkPro AIA Billing Software',
  description:
    'AIA billing software for subcontractors: G702/G703-style pay applications with a schedule of values, retainage, and an approval workflow. $79/month, 14-day free trial.',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'AIA Billing Software',
  operatingSystem: 'Web',
  url: `${config.siteUrl}/features/pay-applications/`,
  image: `${config.siteUrl}/screenshots/13-pay-app-detail.png`,
  featureList: [
    'AIA G702/G703-style pay applications',
    'Schedule of values',
    'Retainage tracking',
    'Stored materials',
    'Approval workflow',
    'PDF pay apps emailed to the GC',
  ],
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Subcontractors and specialty trade contractors',
  },
  offers: {
    '@type': 'Offer',
    name: 'BuildWorkPro monthly plan',
    url: config.signupUrl,
    price: '79',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    category: 'SaaS subscription',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '79',
      priceCurrency: 'USD',
      billingIncrement: 1,
      unitText: 'MONTH',
    },
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${config.siteUrl}/#organization`,
    name: 'BuildWorkPro',
    url: config.siteUrl,
  },
};

const faqs = [
  {
    question: 'What is AIA billing software?',
    answer:
      'AIA billing software is construction pay application software that produces G702/G703-style progress billing: a schedule of values, retainage, stored materials, and previous applications rolled into the current amount due. BuildWorkPro is AIA billing software for subcontractors — it prefills the contract sum from your accepted bid, carries every period forward, tracks retainage, and emails an AIA-style PDF to your GC. It is not a licensed AIA Contract Documents product; confirm with your GC whether they require the official forms.',
  },
  {
    question: 'What is a pay application in construction?',
    answer:
      'A pay application (or pay app) is the document a subcontractor submits to a general contractor to bill for work completed during a billing period. It breaks the contract into a schedule of values, shows what was billed in prior periods, what was completed this period, and any materials stored on site, then accounts for retainage to arrive at the current amount due. In BuildWorkPro, each pay app is tied to one project and moves through an approval workflow from Draft to Paid.',
  },
  {
    question: 'Can I make an AIA-style pay app without Excel?',
    answer:
      'Yes. In BuildWorkPro, each pay app is built from the project: the contract sum prefills from your accepted bid and approved change orders, previous periods carry forward, retainage is tracked, and the AIA-style PDF is emailed to your GC from the app — no workbook to rebuild each month. For a single job, the free Pay App Builder at buildworkpro.com/tools/pay-app/ runs in your browser: type your schedule of values, get the math and a filled G702/G703-style PDF, and roll it forward next month. Prefer a spreadsheet? The free template at buildworkpro.com/templates/aia-g702-g703/ has the math wired.',
  },
  {
    question: 'How does the schedule of values work in BuildWorkPro?',
    answer:
      "When you create a pay app, the Original Contract Sum prefills from the project's accepted bid and the Change Orders Total prefills from approved change orders. The first pay app on a project seeds its schedule of values from any pending approved change orders, and every later pay app carries forward the lines and previous-period totals from the one before it. Each period you enter This Period and Materials Stored for each line, and BuildWorkPro rolls it all up into the amount due.",
  },
  {
    question: 'How does retainage work?',
    answer:
      'Every pay app has a Retainage % field, set when you create it. It defaults to 10 and is adjustable per pay app to match whatever your contract specifies. BuildWorkPro tracks retainage on each pay app so the amount you bill reflects what the customer is holding back.',
  },
  {
    question: 'What does the approval workflow look like?',
    answer:
      'A pay app moves through five statuses: Draft, Submitted, Approved, Rejected, and Paid. Submitting locks the pay app for editing; a company admin or manager then approves it for payment, or rejects it back to Draft with a written rejection reason. Once approved, Mark as Paid records the payment, and a workflow stepper on the detail page shows where the pay app stands and who acted at each step.',
  },
  {
    question: 'Does BuildWorkPro produce AIA-style PDFs I can send to my GC?',
    answer:
      'Yes. Every pay app renders to a PDF you can preview in a dialog, download, or email straight from the detail page — files are named after the document, like PayApp-P-1024-PA001.pdf. The Send to Customer dialog attaches the PDF automatically and supports email templates with merge fields for the document number, project name, and amount. BuildWorkPro produces AIA-style progress billing documents with a schedule of values and retainage — not the copyrighted AIA G702/G703 forms themselves. If you just need a spreadsheet for now, our free G702/G703-style pay application template at buildworkpro.com/templates/aia-g702-g703/ covers the manual workflow.',
  },
  {
    question: 'How much does it cost?',
    answer:
      'Pay applications are included in the single BuildWorkPro plan: $79/month (or $790/year) with unlimited users and every feature included. There is a 14-day free trial with no credit card required.',
  },
];
---

<Layout
  title="Pay Application Software for Subcontractors | AIA-Style"
  description="Pay application software for subcontractors: AIA-style G702/G703 pay apps with schedule of values, retainage and GC-ready PDFs. $79/mo flat, 14-day trial."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(softwareApplicationSchema)}
  />
  <Header />
  <main class="pt-32 pb-20">
    <!-- Hero -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">Features</p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          Pay Application Software for Subcontractors
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          BuildWorkPro is pay application software and AIA billing software for trade subs. Bill
          your GC each period with G702/G703-style pay applications: a schedule of values that
          prefills from your accepted bid and approved change orders, retainage tracked on every pay
          app, and an approval workflow from draft through paid. Email the PDF without leaving
          BuildWorkPro.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={config.signupUrl}
            class="inline-flex items-center px-8 py-3.5 text-base font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <a
            href="/features/"
            class="inline-flex items-center px-8 py-3.5 text-base font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl transition-all"
          >
            All features
          </a>
        </div>
      </div>
    </section>

    <!-- Product proof -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <DemoVideo
        src="/videos/pay-app-demo.mp4"
        poster="/videos/pay-app-demo-poster.jpg"
        label="Demo: billing a pay application period — entering this period's progress in the schedule of values and watching retainage and the current payment due recalculate"
        caption="Bill the period right in the schedule of values — by dollar amount, percent complete, or materials stored on site. Save, and retainage and the amount due recalculate."
      />
    </section>

    <!-- Overview -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="prose prose-lg prose-slate mx-auto">
        <h2>Pay application software that bills every period without the scramble</h2>
        <p>
          If you bill a GC monthly, you know the drill: dig out last month's pay app, reconcile what
          you already billed, chase down approved change orders, rebuild the spreadsheet, and hope
          the math holds. In BuildWorkPro, a pay app is created against the project — set the period
          start and end, and the original contract sum prefills from your
          <a href="/features/construction-bidding/">accepted bid</a> while the change orders total pulls
          from your approved <a href="/features/change-orders/">construction change orders</a>.
          Retainage defaults to 10% and adjusts to whatever your contract says.
        </p>
        <p>
          The schedule of values does the bookkeeping between periods. The first pay app on a
          project seeds its lines from pending approved change orders; every pay app after that
          carries forward the lines and previous-period totals from the one before it. Each period
          you enter what was completed and any materials stored, and BuildWorkPro rolls it up into
          the amount due. Numbering is automatic too — pay apps are assigned per-project numbers
          like P-1024-PA001. The docs cover the details:
          <a href="/docs/pay-apps/creating/">creating a pay app</a> and the
          <a href="/docs/pay-apps/schedule-of-values/">schedule of values</a>.
        </p>
        <p>
          New to progress billing? Our
          <a href="/blog/aia-pay-application-guide/">guide to AIA pay applications</a> explains the format,
          the math, and what GCs look for before they approve. The last application on a job — remaining
          contract balance plus retainage — only moves when the rest of the
          <a href="/blog/construction-project-closeout-checklist/"
            >construction project closeout checklist</a
          >
          is in: punch list, closeout documents, and lien waivers. If you still bill from a spreadsheet,
          start with the free
          <a href="/templates/aia-g702-g703/">G702/G703-style pay application template</a>, or fill
          one out in your browser with the free <a href="/tools/pay-app/">Pay App Builder</a>.
        </p>
      </div>
    </section>

    <!-- AIA billing vs Excel -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-4">
        AIA billing vs Excel G702/G703
      </h2>
      <p class="text-slate-500 text-center max-w-2xl mx-auto mb-10 leading-relaxed">
        Most GCs expect G702/G703-style paperwork. You can fill that by hand in Excel, or let AIA
        billing software carry the schedule of values, retainage, and previous applications forward
        each period.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-8 rounded-2xl border border-slate-200 bg-white">
          <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">
            Spreadsheet
          </p>
          <h3 class="text-lg font-semibold text-slate-900 mb-4">Excel G702/G703 template</h3>
          <ul class="space-y-3 text-sm text-slate-600">
            <li>You rebuild or copy the workbook every billing period.</li>
            <li>Previous applications are rolled forward by hand — easy to miss a line.</li>
            <li>
              <a href="/features/change-orders/" class="text-brand-600 hover:underline"
                >Construction change orders</a
              > live in another file, so the contract sum can drift.
            </li>
            <li>Formulas break the moment someone overtypes a cell.</li>
          </ul>
          <p class="mt-6 text-sm text-slate-500">
            Fine for one job.
            <a href="/templates/aia-g702-g703/" class="text-brand-600 hover:underline"
              >Download the free G702/G703-style template</a
            >
            if you want the math wired before you switch tools.
          </p>
        </div>
        <div class="p-8 rounded-2xl border border-brand-200 bg-brand-50/40 ring-1 ring-brand-100">
          <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-2">Software</p>
          <h3 class="text-lg font-semibold text-slate-900 mb-4">BuildWorkPro AIA billing</h3>
          <ul class="space-y-3 text-sm text-slate-600">
            <li>Schedule of values prefills from your accepted bid and approved change orders.</li>
            <li>Previous applications lock and carry forward automatically.</li>
            <li>Retainage is a field on every pay app, not a side calculation.</li>
            <li>
              Email an AIA-style PDF to your GC from the pay app — no export-import round trip.
            </li>
          </ul>
          <p class="mt-6 text-sm text-slate-500">
            $79/month flat, 14-day free trial. Not an official AIA form — GCs who require the
            licensed documents should say so up front.
          </p>
        </div>
      </div>
    </section>

    <!-- Key Capabilities -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-12">
        Key capabilities
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-rose-50 ring-1 ring-rose-100 mb-4">
            <svg
              class="w-6 h-6 text-rose-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Schedule of values</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Every line tracks scheduled value, previous apps, this period, materials stored, and
            total to date, with a grand total row summing the contract. Previous billings carry
            forward from the prior pay app and lock once an earlier pay app exists.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-rose-50 ring-1 ring-rose-100 mb-4">
            <svg
              class="w-6 h-6 text-rose-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Prefilled contract sums</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            The original contract sum prefills from the project's accepted bid and the change orders
            total from approved change orders — the contract value on your pay app matches the job,
            not a stale spreadsheet.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-rose-50 ring-1 ring-rose-100 mb-4">
            <svg
              class="w-6 h-6 text-rose-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Retainage on every pay app</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Set Retainage % when you create the pay app — it defaults to 10 and adjusts per pay app
            to match your contract terms, so the holdback is part of the math instead of an
            afterthought.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-rose-50 ring-1 ring-rose-100 mb-4">
            <svg
              class="w-6 h-6 text-rose-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Approval workflow</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Draft, Submitted, Approved, Rejected, Paid. Submitting locks the pay app for editing,
            rejections carry a written reason, and a workflow stepper on the detail page shows who
            acted at each step.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-rose-50 ring-1 ring-rose-100 mb-4">
            <svg
              class="w-6 h-6 text-rose-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">AIA-style PDF</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Preview the pay app PDF in a dialog or download it directly — files are named after the
            document, like PayApp-P-1024-PA001.pdf. Progress billing with the schedule of values
            your GC expects.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-rose-50 ring-1 ring-rose-100 mb-4">
            <svg
              class="w-6 h-6 text-rose-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Email from the app</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Send to Customer emails the pay app with the PDF attached automatically. Pick an email
            template with merge fields for the document number, project name, and amount, set To,
            Cc, and Bcc, and send.
          </p>
        </div>
      </div>
    </section>

    <!-- Pay apps list screenshot -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <Screenshot
        src="/screenshots/12-pay-apps-list.png"
        alt="BuildWorkPro pay apps list showing pay app number, project, status, billing period, and amounts"
        caption="Every pay app across your projects in one list — filter by status or search by number or project."
        width={1280}
        height={720}
      />
    </section>

    <!-- How It Works -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-12">How it works</h2>
      <div class="space-y-8">
        <div class="flex gap-4">
          <div
            class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold"
          >
            1
          </div>
          <div>
            <h3 class="text-base font-semibold text-slate-900 mb-1">Create the pay app</h3>
            <p class="text-slate-500">
              Pick the project and set the period start and end. The original contract sum and
              change orders total prefill, retainage defaults to 10%, and the pay app number is
              assigned automatically — or set your own.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div
            class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold"
          >
            2
          </div>
          <div>
            <h3 class="text-base font-semibold text-slate-900 mb-1">
              Enter this period's progress
            </h3>
            <p class="text-slate-500">
              Work down the schedule of values: enter This Period and any Materials Stored for each
              line. Previous billings are already carried forward from the prior pay app, so you
              only touch what changed.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div
            class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold"
          >
            3
          </div>
          <div>
            <h3 class="text-base font-semibold text-slate-900 mb-1">Submit for approval</h3>
            <p class="text-slate-500">
              Submitting locks the pay app for editing. A company admin or manager reviews the
              schedule of values, then approves it for payment or rejects it back to draft with a
              reason.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div
            class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold"
          >
            4
          </div>
          <div>
            <h3 class="text-base font-semibold text-slate-900 mb-1">Send it and record payment</h3>
            <p class="text-slate-500">
              Email the PDF to your customer straight from the detail page. When the money lands,
              Mark as Paid closes the loop — or click Create Invoice to bill from the approved pay
              app directly.
            </p>
          </div>
        </div>
      </div>
      <p class="mt-10 text-center text-sm text-slate-400">
        Full walkthrough in the docs:
        <a href="/docs/pay-apps/creating/" class="text-brand-600 hover:underline"
          >Creating a pay app</a
        >
        ·
        <a href="/docs/pay-apps/schedule-of-values/" class="text-brand-600 hover:underline"
          >Schedule of values</a
        >
        ·
        <a href="/docs/pay-apps/approval-workflow/" class="text-brand-600 hover:underline"
          >Approval workflow</a
        >
      </p>
    </section>

    <TemplateCallout
      slugs={[
        'aia-g702-g703',
        'schedule-of-values',
        'lien-waiver',
        'construction-invoice',
        'change-order',
        'certificate-of-completion',
      ]}
    />
    <FAQSection faqs={faqs} />

    <!-- Bottom CTA -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">
        Switch from Excel G702/G703 to AIA billing software
      </h2>
      <p class="text-lg text-slate-500 mb-8">
        Pay applications are included in the $79/month flat plan — unlimited users, every feature.
        14-day free trial, no credit card required.
      </p>
      <a
        href={config.signupUrl}
