---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import TemplateCallout from '../../components/templates/TemplateCallout.astro';
import Screenshot from '../../components/Screenshot.astro';
import DemoVideo from '../../components/DemoVideo.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { productVideos } from '../../data/productVideos';
import { config } from '../../config';

const faqs = [
  {
    question: 'What is construction bidding software?',
    answer:
      'Construction bidding software replaces spreadsheet estimating with structured bids: line items broken into material, labor, and other costs; margin, overhead, and commission applied consistently; and a professional PDF proposal generated from the same numbers. In BuildWorkPro, every bid also tracks its status — draft, sent, accepted, or rejected — and a won bid converts directly into a project.',
  },
  {
    question: 'Is BuildWorkPro construction estimating software?',
    answer:
      'Yes. BuildWorkPro is construction estimating software built for subcontractors. You build each estimate from line items typed as material, labor, or other cost, pull prices from a reusable catalog instead of retyping them, and apply margin, overhead, and commission on the Rates tab so your sell price is systematic rather than guessed. The same estimate becomes a branded PDF proposal and, once accepted, converts straight into a project — so the numbers you estimated carry into the schedule and your first pay application.',
  },
  {
    question: 'How does BuildWorkPro handle labor and material pricing?',
    answer:
      'Every line item breaks down into cost items typed as Material, Labor, or Other, each with its own cost, sell price, and tax settings. You can pull items from a reusable product catalog instead of retyping prices, and import vendor price lists from CSV with reusable column mappings.',
  },
  {
    question: 'Can I reuse estimates from past jobs?',
    answer:
      'Yes, two ways. Duplicate any past bid as a starting point, or save a bid template that captures your estimate structure, payment terms, and conditions — so repeat work starts 80% done instead of from a blank page.',
  },
  {
    question: 'How do markup, overhead, and bid-level costs work?',
    answer:
      "The Rates tab sets the margin, commission, and overhead applied to the bid, so your sell price is systematic instead of guessed. Job-wide costs like mobilization, a dumpster, or permits go in Project Costs, and BuildWorkPro spreads them across your line items' sell prices automatically.",
  },
  {
    question: 'What happens when I win the bid?',
    answer:
      'Convert the accepted bid into an active project in one click. The contract value carries into the project, and when you create your first pay application, the original contract sum and schedule of values prefill from the bid — no re-entering numbers.',
  },
  {
    question: 'How much does it cost?',
    answer:
      'Bidding is included in the single BuildWorkPro plan: $79/month (or $790/year) with unlimited users, unlimited projects, and every feature. There is a 14-day free trial with no credit card required.',
  },
  {
    question: 'How is construction bidding software different from GC project software?',
    answer:
      'GC platforms are built to receive and level bids from many trades. Construction bidding software for subcontractors is built to create those bids: line-item estimates with material, labor, and other costs; margin and overhead applied as rates; a branded PDF proposal; and a one-click path from a won bid into a project and the first pay application. BuildWorkPro is the second kind.',
  },
  {
    question: 'Is there a free construction bidding software option?',
    answer:
      'BuildWorkPro includes a 14-day free trial with no credit card required, so you can build line-item bids, apply margin and overhead, and export PDF proposals before you pay. After the trial, bidding is part of the single $79/month plan (or $790/year) with unlimited users — there is no separate bidding SKU and no forever-free tier.',
  },
];
---

<Layout
  title="Construction Bidding Software for Subs | BuildWorkPro"
  description="Construction bidding software for subcontractors: line-item estimates, margin & overhead, PDF proposals. $79/mo flat, 14-day free trial."
>
  <Header />
  <main class="pt-32 pb-20">
    <!-- Hero -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">Features</p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          Construction Bidding Software for Subcontractors
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          Built around how subs actually estimate: line items broken into material, labor, and other
          costs; margin, overhead, and commission applied as rates; a branded PDF proposal; and a
          won bid that converts straight into a project.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={config.signupUrl}
            class="inline-flex items-center px-8 py-3.5 text-base font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <a
            href="/features/"
            class="inline-flex items-center px-8 py-3.5 text-base font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl transition-all"
          >
            All features
          </a>
        </div>
      </div>
    </section>

    <!-- Product proof -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <DemoVideo
        src="/videos/create-bid.mp4"
        poster="/videos/create-bid-poster.jpg"
        label="Demo: pricing a bid in BuildWorkPro — adding a catalog line, importing a kit as material and labor cost items, and raising the margin on the Pricing tab"
        caption="Building the estimate: catalog lines and kits break into material and labor cost items that roll up into the bid total — and the Pricing tab turns cost into the customer price with a live preview."
      />
    </section>

    {
      productVideos.createBid.id && (
        <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
          <div class="mb-6 text-center">
            <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">
              Watch the full walkthrough
            </h2>
            <p class="mt-2 text-slate-600">
              A 2½-minute guided tour — from a blank bid to a client-ready PDF.
            </p>
          </div>
          <YouTubeEmbed
            video={productVideos.createBid}
            caption="Full narrated walkthrough: create a bid, build the estimate from your catalog, and export the proposal PDF."
          />
        </section>
      )
    }

    <!-- Overview -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="prose prose-lg prose-slate mx-auto">
        <h2>Stop losing money on inaccurate bids</h2>
        <p>
          For subcontractors, every bid is a balancing act. Price too high and you lose the job.
          Price too low and you eat into your margin on every hour worked. BuildWorkPro is
          construction bidding software that makes that math systematic: break costs into material,
          labor, and other expense, then apply margin, overhead, and commission on the
          <a href="/docs/bids/rates/">Rates tab</a> instead of guessing a single markup number.
        </p>
        <p>
          Every bid lives in your system as a permanent record. You track which bids were sent,
          which are pending, and which you won or lost. Over time your bid history becomes the
          dataset for sharper pricing — and the starting point for the next estimate, since any bid
          can be <a href="/docs/bids/pdf-and-duplication/">duplicated</a> or saved as a
          <a href="/docs/bids/templates/">template</a> with your payment terms and conditions.
        </p>
        <p>
          New to structured bidding? Our guide on
          <a href="/blog/how-to-create-construction-bid/">how to create a construction bid</a>
          walks through the full process, from takeoff to proposal. Win the job and the estimate flows
          straight into <a href="/features/project-management/">project scheduling</a> and your first
          <a href="/features/pay-applications/">pay application</a> — no re-entering numbers.
        </p>
      </div>
    </section>

    <!-- Subcontractor estimating workflow -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="prose prose-lg prose-slate mx-auto">
        <h2>The subcontractor estimating workflow</h2>
        <p>
          GC software is built to collect bids. Construction bidding software for subcontractors is
          built to <em>create</em> them. The workflow is takeoff → cost the work → protect margin → send
          a proposal the GC will open → convert the win into a job without retyping the numbers.
        </p>
        <h3>Line-item bids with material, labor, and other costs</h3>
        <p>
          Each bid is a list of line items, and each line breaks into cost items typed as Material,
          Labor, or Other — with quantities, units, buy and sell tax, and live rollups. Pull prices
          from a reusable catalog (or import a vendor CSV) instead of hunting last month's
          spreadsheet. Duplicate a past bid or load a
          <a href="/docs/bids/templates/">template</a> when the work repeats.
        </p>
        <h3>Margin, overhead, and commission as rates — not a guessed markup</h3>
        <p>
          The Rates tab applies margin, commission, and overhead to the whole estimate so the sell
          price is systematic. Job-wide costs like mobilization, a dumpster, or permits go in
          Project Costs and spread across line-item sell prices. Markup and margin are not the same
          number —
          <a href="/blog/construction-markup-vs-margin/">confusing them</a> donates profit on every bid.
        </p>
        <h3>PDF proposals, then bid-to-project</h3>
        <p>
          Generate a branded PDF with scope, payment terms, and conditions, and control how much
          cost detail the GC sees. Send it from BuildWorkPro — optionally for
          <a href="/features/construction-bidding/#e-signatures">e-signature</a>. When the bid is
          accepted, one click converts it into a project: the contract value carries over and
          prefills the schedule of values on the first pay application. Scope that changes after the
          bid is won is priced as
          <a href="/features/change-orders/">construction change orders</a> on that same job.
        </p>
      </div>
    </section>

    <!-- vs GC-first tools -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-4">
        Not GC bid-leveling software
      </h2>
      <p class="text-slate-500 text-center max-w-2xl mx-auto mb-10 leading-relaxed">
        Most construction platforms are built for general contractors who buy work. Subcontractors
        sell work — so subcontractor bidding software has to estimate, price, and propose, not just
        track inbound numbers.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-8 rounded-2xl border border-slate-200 bg-white">
          <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">
            GC-first tools
          </p>
          <h3 class="text-lg font-semibold text-slate-900 mb-4">Bid leveling and coordination</h3>
          <ul class="space-y-3 text-sm text-slate-600">
            <li>Built to receive and compare bids from many trades, not to build yours.</li>
            <li>Estimating often still happens in Excel, then gets pasted into the GC's portal.</li>
            <li>Quote-based or per-user pricing that punishes putting the field on the system.</li>
            <li>
              Won work does not become <em>your</em> project, pay app, or change-order record.
            </li>
          </ul>
          <p class="mt-6 text-sm text-slate-500">
            Fine when a GC requires collaborator access on their job. That access is not a system of
            record for your company — see
            <a
              href="/blog/subcontractor-vs-general-contractor-software/"
              class="text-brand-600 hover:underline"
              >subcontractor vs. general contractor software</a
            >. Quote-based GC platforms price bidding inside an ACV bundle; see
            <a
              href="/blog/procore-pricing-for-subcontractors/"
              class="text-brand-600 hover:underline">Procore pricing for subcontractors</a
            >
            for independently reported ranges.
          </p>
        </div>
        <div class="p-8 rounded-2xl border border-brand-200 bg-brand-50/40 ring-1 ring-brand-100">
          <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-2">
            Subcontractor bidding
          </p>
          <h3 class="text-lg font-semibold text-slate-900 mb-4">
            BuildWorkPro construction bidding
          </h3>
          <ul class="space-y-3 text-sm text-slate-600">
            <li>You build the estimate: line items, catalog prices, and typed cost detail.</li>
            <li>
              Margin, overhead, and commission live on the Rates tab, not in a side spreadsheet.
            </li>
            <li>
              Branded PDF proposals, optional e-signature, status from draft through accepted.
            </li>
            <li>
              A won bid converts into a project and prefills the first
              <a href="/features/pay-applications/" class="text-brand-600 hover:underline"
                >pay application</a
              >.
            </li>
          </ul>
          <p class="mt-6 text-sm text-slate-500">
            $79/month flat, unlimited users, 14-day free trial. Bidding is included — not a separate
            estimating SKU.
          </p>
        </div>
      </div>
    </section>

    <!-- Key Capabilities -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-12">
        Key capabilities
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-violet-50 ring-1 ring-violet-100 mb-4">
            <svg
              class="w-6 h-6 text-violet-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Line items with cost detail</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Each line item breaks down into cost items for material, labor, and other costs — with
            quantities, units, buy and sell tax, and per-line totals that roll up live.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-violet-50 ring-1 ring-violet-100 mb-4">
            <svg
              class="w-6 h-6 text-violet-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Reusable product catalog</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Price bids from a catalog of materials, labor, and kits with SKUs, costs, and sell
            prices. Add an item once, pull it into every bid — or import vendor price lists from CSV
            with reusable column mappings.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-violet-50 ring-1 ring-violet-100 mb-4">
            <svg
              class="w-6 h-6 text-violet-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Margin, overhead & commission</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            The Rates tab turns your costs into a sell price systematically — set margin,
            commission, and overhead once per bid instead of hand-tuning every line.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-violet-50 ring-1 ring-violet-100 mb-4">
            <svg
              class="w-6 h-6 text-violet-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Job-wide project costs</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Mobilization, dumpsters, permits — add costs that apply to the whole job and
            BuildWorkPro spreads them across your line items' sell prices, so nothing rides for
            free.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-violet-50 ring-1 ring-violet-100 mb-4">
            <svg
              class="w-6 h-6 text-violet-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Professional PDF proposals</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Generate clean proposals with your branding, scope, payment terms, and conditions.
            Display options control how much cost detail the GC sees. Send it without leaving
            BuildWorkPro.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-100 bg-white">
          <div class="inline-flex p-3 rounded-xl bg-violet-50 ring-1 ring-violet-100 mb-4">
            <svg
              class="w-6 h-6 text-violet-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 mb-2">Bid-to-project conversion</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            When a bid is accepted, convert it into an active project in one click. Your contract
            value flows into the project and prefills the schedule of values on your first
            <a href="/features/pay-applications/" class="text-brand-600 hover:underline"
              >pay application</a
            >.
          </p>
        </div>
      </div>
    </section>

    <!-- Markup screenshot -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <Screenshot
        src="/screenshots/07-bid-detail-rates.png"
        alt="BuildWorkPro bid Pricing tab with margin, commission, company overhead, and sales tax settings beside a live preview of the total, margin, materials, people costs, and overhead"
        caption="Margin, commission, and overhead applied once — every line item's sell price stays consistent."
      />
    </section>

    <!-- E-signature -->
    <section id="e-signatures" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-20 scroll-mt-32">
      <div class="rounded-2xl border border-slate-100 bg-white p-8 sm:p-10">
        <div class="flex items-start gap-4">
          <div class="inline-flex p-3 rounded-xl bg-sky-50 ring-1 ring-sky-100 shrink-0">
            <svg
              class="w-6 h-6 text-sky-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"
              ></path>
            </svg>
          </div>
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
              Get the bid signed, not just sent
            </h2>
            <p class="mt-3 text-slate-500 leading-relaxed">
              Send a bid for legally-binding e-signature and the acceptance takes care of itself.
              Your customer signs from an emailed link — no BuildWorkPro account, no app to install,
              no login — and the moment they do, the bid is accepted in your system.
            </p>
          </div>
        </div>

        <div class="mt-8 grid sm:grid-cols-3 gap-6">
          <div>
            <div
              class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold mb-3"
            >
              1
            </div>
            <h3 class="text-base font-semibold text-slate-900 mb-1">Send it for signature</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              Request a signature when you send the proposal. The signing link goes out with the
              same branded PDF you already send.
            </p>
          </div>
          <div>
            <div
              class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold mb-3"
            >
              2
            </div>
            <h3 class="text-base font-semibold text-slate-900 mb-1">They sign from the link</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              One link, any browser. Nothing to download and no account to create — the same thing
              you would want if you were on their side of it.
            </p>
          </div>
          <div>
            <div
              class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold mb-3"
            >
              3
            </div>
            <h3 class="text-base font-semibold text-slate-900 mb-1">The bid accepts itself</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              A signed bid is an accepted bid — same status, same totals, and the same one-click
              conversion into a project.
            </p>
          </div>
        </div>

        <p class="mt-8 text-sm text-slate-400 leading-relaxed">
          BuildWorkPro chases the signature for you with automated reminders, and files the
          certified signed PDF back onto the bid's Documents — so the executed contract lives with
          the job instead of in someone's inbox. E-signature runs on
          <a href="/integrations/" class="text-brand-600 hover:underline">Documenso</a> and is included
          in the $79/month plan.
        </p>
      </div>
    </section>

    <!-- How It Works -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
