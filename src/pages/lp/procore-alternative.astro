---
import Layout from '../../layouts/Layout.astro';
import Screenshot from '../../components/Screenshot.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { config } from '../../config';

// Subset of the rows on /compare/procore-alternative/ — enough to make the
// $79 vs quote-based $4,500–$10,000+ claim and the sub-not-GC positioning,
// without the full compare-page essay. Values stay in lockstep with that page.
const comparisonRows = [
  {
    label: 'Built for',
    bwp: 'Trade subcontractors',
    other: 'General contractors & owners',
    bwpWins: true,
  },
  {
    label: 'Pricing',
    bwp: '$79/month flat, published',
    other: 'Custom quote based on construction volume',
    bwpWins: true,
  },
  {
    label: 'Typical annual cost',
    bwp: '$790/year (annual plan)',
    other: '$4,500–$10,000+/year for small contractors*',
    bwpWins: true,
  },
  {
    label: 'How you buy',
    bwp: 'Self-serve signup, 14-day free trial',
    other: 'Sales demo and quote process',
    bwpWins: true,
  },
  {
    label: 'Users',
    bwp: 'Unlimited',
    other: 'Unlimited',
    bwpWins: false,
  },
  {
    label: 'Bidding & estimating for subs',
    bwp: 'Line items, labor rates, markup, PDF proposals',
    other: 'Bid management oriented to GCs receiving bids',
    bwpWins: true,
  },
];
---

<Layout
  title="Procore Alternative for Subcontractors — $79/month | BuildWorkPro"
  description="Procore alternative for specialty subcontractors. Published $79/month (or $790/year) vs quote-based $4,500–$10,000+/year. 14-day free trial, unlimited users."
  noindex
>
  <!-- Minimal ads chrome: logo home + one trial CTA. No mega-nav, no contact CTA. -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 lg:h-20">
        <a href="/" class="flex items-center">
          <picture>
            <source
              type="image/webp"
              srcset="/logo-190.webp 190w, /logo-380.webp 380w"
              sizes="(min-width: 1024px) 193px, 177px"
            />
            <img
              src="/logo.png"
              alt="BuildWorkPro"
              width="950"
              height="236"
              class="h-11 lg:h-12 w-auto"
              decoding="async"
            />
          </picture>
        </a>
        <a
          href={config.signupUrl}
          class="text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 px-5 py-2.5 rounded-lg transition-all hover:-translate-y-0.5"
        >
          Start free trial
        </a>
      </div>
    </div>
  </header>

  <main class="pt-12 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
          Procore alternative for subcontractors
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          The Procore Alternative Built for Subcontractors
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          Published <strong class="text-slate-700">$79/month</strong> (or $790/year) — not a quote-based
          <strong class="text-slate-700">$4,500–$10,000+/year</strong> for small contractors.* Built for
          specialty trades, not general contractors. Unlimited users, 14-day free trial, no sales call.
        </p>
        <div class="mt-8">
          <a
            href={config.signupUrl}
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <p class="mt-3 text-sm text-slate-500">14-day free trial · No credit card required</p>
        </div>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">
        BuildWorkPro vs Procore at a glance
      </h2>
      <ComparisonTable rows={comparisonRows} competitor="Procore" />
      <p class="mt-3 text-xs text-slate-400 px-2">
        *Procore doesn't publish pricing; quotes are based on annual construction volume and
        licensed products. Range reflects figures commonly reported in independent pricing analyses
        as of June 2026. Verify current pricing with Procore.
      </p>
    </section>

    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20 mt-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-4">
        Bids and pay apps in one place
      </h2>
      <p class="text-center text-slate-500 max-w-2xl mx-auto mb-10">
        Estimate the work, then bill it against a schedule of values — without a GC-priced platform.
      </p>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <Screenshot
            src="/screenshots/05-bid-detail-overview.png"
            alt="BuildWorkPro accepted bid with its cost breakdown — materials, people costs, overhead, and margin — behind the customer total"
            caption="Bids: line items, labor rates, markup, and a PDF proposal."
            eager
          />
        </div>
        <div>
          <Screenshot
            src="/screenshots/13-pay-app-detail.png"
            alt="BuildWorkPro pay application with schedule of values, retainage, and approval status"
            caption="Pay apps: AIA-style progress billing with schedule of values and retainage."
          />
        </div>
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="rounded-2xl bg-slate-900 px-8 py-14 sm:px-14">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Start a 14-day free trial
        </h2>
        <p class="mt-4 text-slate-400 max-w-xl mx-auto">
          $79/month or $790/year. Every feature, unlimited users. No demo call, no quote process.
        </p>
        <div class="mt-8">
          <a
            href={config.signupUrl}
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-slate-900 text-slate-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm">&copy; {new Date().getFullYear()} BuildWorkPro. All rights reserved.</p>
        <nav class="flex items-center gap-4 text-sm" aria-label="Legal">
          <a href="/privacy/" class="hover:text-white transition-colors">Privacy</a>
          <a href="/terms/" class="hover:text-white transition-colors">Terms</a>
          <button
            type="button"
            id="footer-cookie-settings"
            class="hover:text-white transition-colors cursor-pointer"
          >
            Cookie settings
          </button>
        </nav>
      </div>
    </div>
  </footer>
</Layout>

<script>
  document.getElementById('footer-cookie-settings')?.addEventListener('click', () => {
    (window as any).bwpOpenCookieSettings?.();
  });
</script>
