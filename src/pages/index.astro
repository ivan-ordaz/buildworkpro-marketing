---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AgentCrew from '../components/AgentCrew.astro';
import LogoCloud from '../components/LogoCloud.astro';
import Features from '../components/Features.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import Integrations from '../components/Integrations.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import TemplateCallout from '../components/templates/TemplateCallout.astro';
import { config } from '../config';

const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${config.siteUrl}/#software`,
  name: 'BuildWorkPro',
  description:
    'Construction project management and ERP software for subcontractors. Bidding, pay applications, change orders, project management, site logs, time tracking, CRM, and reporting in one platform.',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Construction Management Software',
  // 'Web' only until the iOS/Android store listings are live (issue #127) —
  // structured data must never claim apps that can't be found in the stores.
  operatingSystem: 'Web',
  url: config.siteUrl,
  image: `${config.siteUrl}/og-image.png`,
  screenshot: [
    `${config.siteUrl}/screenshots/00-hero.png`,
    `${config.siteUrl}/screenshots/13-pay-app-detail.png`,
    `${config.siteUrl}/screenshots/17-project-gantt.png`,
  ],
  featureList: [
    'Construction bidding and estimating',
    'Project management with phases, tasks, and Gantt charts',
    'AIA-style pay applications and schedule of values',
    'Change order workflows',
    'E-signatures for bids and change orders',
    'Daily site logs and field documentation',
    'Crew time tracking',
    'Construction CRM and sales pipeline',
    'Reports and analytics',
    'MCP connection for AI agents (Claude, ChatGPT, Grok Bot, OpenClaw, Hermes Agent)',
  ],
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Subcontractors and specialty trade contractors',
  },
  offers: {
    '@type': 'Offer',
    name: 'BuildWorkPro monthly plan',
    url: config.signupUrl,
    price: '79',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    category: 'SaaS subscription',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '79',
      priceCurrency: 'USD',
      billingIncrement: 1,
      unitText: 'MONTH',
    },
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${config.siteUrl}/#organization`,
    name: 'BuildWorkPro',
    url: config.siteUrl,
  },
};
---

<Layout
  title="Construction Project Management Software for Subcontractors | BuildWorkPro"
  description="Construction software built for subcontractors and small business — bids, pay apps, change orders, projects & crew. $79/month flat. 14-day free trial."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(softwareApplicationSchema)}
  />
  <Header />
  <main>
    <Hero />
    <AgentCrew />
    <LogoCloud />
    <Features />
    <FeatureShowcase />
    <Integrations />
    <TemplateCallout
      heading="Free templates and tools for subcontractors"
      class="mb-24 lg:mb-32"
      slugs={[
        'aia-g702-g703',
        'lien-waiver',
        'change-order',
        'daily-report',
        'construction-estimate',
        'schedule-of-values',
      ]}
    >
      Rather fill one in online? The
      <a href="/tools/pay-app/" class="font-medium text-brand-600 hover:text-brand-700"
        >free pay app builder</a
      >
      does the G702/G703-style math in your browser. Weighing software?
      <a href="/compare/" class="font-medium text-brand-600 hover:text-brand-700"
        >Compare BuildWorkPro with Procore, Buildertrend and others</a
      >, or read our
      <a href="/blog/" class="font-medium text-brand-600 hover:text-brand-700"
        >guides for subcontractors</a
      > on billing, bidding and closeout.
    </TemplateCallout>
    <Pricing />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Layout>
