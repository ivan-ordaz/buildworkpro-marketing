---
// The /templates/ hub (issue #134). Live templates get cards with downloads;
// the planned set is listed as coming-soon so the hub communicates scope
// without shipping thin placeholder pages. Build order and keyword data:
// gameplan artifact + .growth-review/sweep-2026-08-10/.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { config } from '../../config';

const live = [
  {
    title: 'Construction Change Order Template',
    description:
      'One-page change order: description, contract-sum adjustment table, time extension, and dual signatures before the work starts.',
    href: '/templates/change-order/',
    format: 'Word (.docx)',
  },
  {
    title: 'Construction Invoice Template',
    description:
      'Line items with computed amounts, adjustable sales tax, total due, and payment terms — for work billed directly, not through a GC.',
    href: '/templates/construction-invoice/',
    format: 'Excel (.xlsx)',
  },
  {
    title: 'Construction Punch List Template',
    description:
      '40-row tracker with live open/complete counts, priority, responsible trade, and a verified-by column.',
    href: '/templates/punch-list/',
    format: 'Excel (.xlsx)',
  },
  {
    title: 'Construction Schedule Template',
    description:
      '35 tasks by phase with computed durations, % complete, and predecessor notes — the schedule that survives the job.',
    href: '/templates/construction-schedule/',
    format: 'Excel (.xlsx)',
  },
  {
    title: 'Daily Report Template',
    description:
      'Print-ready daily construction report: crew, weather, work performed, deliveries, delays, and safety — with the guide that explains each section.',
    href: '/blog/construction-daily-report-template/',
    format: 'Word (.docx)',
  },
  {
    title: 'Construction Bid Proposal Template',
    description:
      'Scope, price with alternates, inclusions/exclusions, terms, and an acceptance signature block — the wrapper around your number.',
    href: '/templates/construction-bid-proposal/',
    format: 'Word (.docx)',
  },
  {
    title: 'Construction Estimate Template',
    description:
      '25-line estimate with material/labor split, overhead, and true-margin pricing — the markup-vs-margin math done right.',
    href: '/templates/construction-estimate/',
    format: 'Excel (.xlsx)',
  },
  {
    title: 'Schedule of Values Template',
    description:
      '30-row Excel SOV with % of contract math, a tie-out check against the contract sum, and sample trade line items.',
    href: '/templates/schedule-of-values/',
    format: 'Excel (.xlsx)',
  },
  {
    title: 'Subcontractor Agreement Template',
    description:
      '14-section standard-form subcontract — scope, retainage, written change orders, lien waivers — as an editable Word document.',
    href: '/templates/subcontractor-agreement/',
    format: 'Word (.docx)',
  },
  {
    title: 'Pay Application Template (G702 & G703 style)',
    description:
      'Excel workbook with a G702-style summary, G703-style continuation sheet, retainage math, and carry-forward between billing periods.',
    href: '/templates/aia-g702-g703/',
    format: 'Excel (.xlsx)',
  },
];
---

<Layout
  title="Free Construction Templates for Subcontractors | BuildWorkPro"
  description="Free downloadable construction templates: G702/G703-style pay application, schedule of values, change orders, and more. No email required."
>
  <Header />
  <main class="pt-32 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">Templates</p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
          Free construction templates for subcontractors
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          The paperwork GCs expect — pay applications, schedules of values, change orders — as
          working spreadsheets and documents. Free, no email required.
        </p>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="grid sm:grid-cols-2 gap-6">
        {
          live.map((t) => (
            <a
              href={t.href}
              class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-200 transition-all"
            >
              <div class="flex items-center justify-between mb-3">
                <span class="inline-flex text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700">
                  Free download
                </span>
                <span class="text-xs text-slate-400">{t.format}</span>
              </div>
              <h2 class="text-lg font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
                {t.title}
              </h2>
              <p class="mt-2 text-sm text-slate-500 leading-relaxed">{t.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
                Get the template <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 px-8 py-10 sm:px-12">
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight text-balance">
          Want the whole set?
        </h2>
        <p class="mt-3 text-slate-500 leading-relaxed">
          Every template above is a free, direct download — no email needed. But if you'd rather
          grab everything at once, we'll send you all 10 files in a single email.
        </p>
        <form id="template-pack-form" class="mt-6 space-y-4">
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="email"
              name="email"
              required
              placeholder="you@company.com"
              aria-label="Email address"
              class="flex-1 px-4 py-2.5 rounded-lg border border-slate-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            />
            <button
              type="submit"
              id="template-pack-submit"
              class="px-6 py-2.5 rounded-lg bg-brand-600 text-white font-semibold text-sm hover:bg-brand-700 transition-colors whitespace-nowrap"
            >
              Email me all 10
            </button>
          </div>
          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="template-pack-consent"
              required
              class="mt-0.5 h-4 w-4 rounded border-slate-200 text-brand-600 focus:ring-2 focus:ring-brand-500"
            />
            <label for="template-pack-consent" class="text-sm text-slate-600">
              I agree to the processing of my personal data as described in the <a
                href="/privacy/"
                class="text-brand-600 hover:text-brand-700 font-medium underline">Privacy Policy</a
              >.
            </label>
          </div>
          <div id="template-pack-turnstile"></div>
          <div id="template-pack-status" class="hidden text-sm rounded-lg px-4 py-3"></div>
        </form>
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="rounded-2xl bg-slate-900 px-8 py-12 sm:px-14">
        <h2 class="text-2xl font-extrabold text-white tracking-tight text-balance">
          Or stop filling out templates altogether
        </h2>
        <p class="mt-3 text-slate-400 max-w-xl mx-auto">
          BuildWorkPro generates bids, pay applications, and change orders from your project data —
          $79/month flat, unlimited users.
        </p>
        <a
          href={config.signupUrl}
          class="mt-6 inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
        >
          Start free trial
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  declare const turnstile: any;

  function initTemplatePackForm() {
    const form = document.getElementById('template-pack-form') as HTMLFormElement | null;
    const status = document.getElementById('template-pack-status');
    const submitBtn = document.getElementById('template-pack-submit') as HTMLButtonElement | null;
    const container = document.getElementById('template-pack-turnstile');
    if (!form || !status || !submitBtn || !container) return;

    const sitekey = document.body.dataset.turnstileSitekey;
    let turnstileToken = '';
    let widgetId: string | undefined;

    function renderWidget() {
      if (typeof turnstile === 'undefined' || widgetId !== undefined) return;
      widgetId = turnstile.render(container, {
        sitekey,
        callback: (token: string) => {
          turnstileToken = token;
        },
        'expired-callback': () => {
          turnstileToken = '';
        },
        theme: 'light',
      });
    }

    // Render when Turnstile script loads (may already be loaded)
    if (typeof turnstile !== 'undefined') renderWidget();
    else window.addEventListener('load', renderWidget);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!turnstileToken) {
        status.textContent = 'Please complete the verification above.';
        status.className =
          'text-sm rounded-lg px-4 py-3 bg-amber-50 text-amber-700 border border-amber-200';
        return;
      }

      const fd = new FormData(form);
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      status.className = 'hidden';

      try {
        const res = await fetch('/api/template-pack/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: fd.get('email'),
            'cf-turnstile-response': turnstileToken,
          }),
        });

        if (!res.ok) throw new Error();

        // Same conversion pair as the contact form; the form param separates
        // them in GA4. No-ops for whichever tracker hasn't loaded.
        (window as any).bwpTrack?.(
          { name: 'Lead' },
          { name: 'generate_lead', params: { form: 'template-pack' } }
        );

        status.textContent = 'Sent! Check your inbox for all 10 templates.';
        status.className =
          'text-sm rounded-lg px-4 py-3 bg-green-50 text-green-700 border border-green-200';
        form.reset();
        turnstileToken = '';
        if (widgetId !== undefined) turnstile.reset(widgetId);
      } catch {
        status.textContent =
          'Something went wrong. Every template is also a free download on this page.';
        status.className =
          'text-sm rounded-lg px-4 py-3 bg-red-50 text-red-700 border border-red-200';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Email me all 10';
      }
    });
  }

  initTemplatePackForm();
  document.addEventListener('astro:page-load', initTemplatePackForm);
</script>
