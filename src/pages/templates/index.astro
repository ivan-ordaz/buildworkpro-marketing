---
// The /templates/ hub. Cards come from src/data/templates.ts (registry) and
// previews/file counts from the per-slug manifests written by
// scripts/templates/build.mjs. Keyword data and build order: scripts/templates/PLAN.md.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { config } from '../../config';
import { byCategory, TEMPLATE_LIST } from '../../data/templates';
import { manifest } from '../../data/templates-manifest';

const groups = byCategory();
const fileCount = Object.values(manifest).reduce(
  (n, m) => n + Object.keys(m.files).filter((k) => k !== 'example').length,
  0
);
const templateCount = TEMPLATE_LIST.length;

const faqs = [
  {
    question: 'Are these construction templates really free?',
    answer:
      'Yes. Every template on this page is a direct download — no email, no account, no watermark. Use them on as many jobs as you like and share them with your crew or your GC. The only thing we ask is that you do not resell them as your own product.',
  },
  {
    question: 'Which file formats do the templates come in?',
    answer:
      'Every template ships as a fillable PDF you can type into in Acrobat, Preview or Chrome (or print and fill by hand). Forms that involve math — pay applications, estimates, invoices, schedules, logs — also come as Excel workbooks with the formulas built in. Contracts, agreements and letter-style forms also come as editable Word documents. Each page shows exactly which formats it offers, plus a completed example PDF.',
  },
  {
    question: 'Do the Excel and Word files work in Google Sheets and Google Docs?',
    answer:
      'Yes. Upload the .xlsx to Google Drive and open it in Sheets, or the .docx and open it in Docs — formatting, formulas and dropdowns carry over. They also open in Apple Numbers and Pages and in LibreOffice.',
  },
  {
    question: 'Are the pay application forms official AIA documents?',
    answer:
      'No. AIA, G702 and G703 are trademarks of The American Institute of Architects, and the official forms are licensed through AIA Contract Documents. Our pay application template follows the same information architecture — application summary, continuation sheet, retainage — in our own format, which is what many general contractors accept. Confirm with your GC whether they require the licensed AIA form.',
  },
  {
    question: 'Are the contract and lien waiver templates legal advice?',
    answer:
      'No. They are general-purpose starting points written for U.S. subcontractors. Contract terms, lien law and prompt-payment rules vary by state, and several states require statutory lien waiver forms. Have a construction attorney review any agreement before you rely on it.',
  },
  {
    question: 'How were these templates made?',
    answer:
      'They are generated from the same document design BuildWorkPro uses for the bids, change orders, invoices, pay applications and daily reports it produces for subcontractors, and they are checked on real jobs run by our founder’s own glazing company. Every template is rebuilt from source, so when we improve one, every format updates together.',
  },
];
---

<Layout
  title="Free Construction Templates & Forms for Contractors"
  description={`${templateCount} free construction templates for subcontractors: G702/G703-style pay application, schedule of values, change order, daily report, lien waivers, estimates and more. Fillable PDF, Excel and Word. No email required.`}
>
  <Header />
  <main class="pt-32 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-14">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">Templates</p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
          Free construction templates for subcontractors
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          The paperwork GCs, owners and inspectors expect — pay applications, schedules of values,
          change orders, daily reports, lien waivers, contracts — as fillable PDFs, Excel workbooks
          with the formulas built in, and editable Word documents. Free, no email required.
        </p>
        <dl class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-slate-500">
          <div class="flex items-baseline gap-1.5">
            <dt class="sr-only">Templates</dt>
            <dd><span class="text-xl font-bold text-slate-900">{templateCount}</span> templates</dd>
          </div>
          <div class="flex items-baseline gap-1.5">
            <dt class="sr-only">Files</dt>
            <dd>
              <span class="text-xl font-bold text-slate-900">{fileCount}</span> downloadable files
            </dd>
          </div>
          <div class="flex items-baseline gap-1.5">
            <dt class="sr-only">Formats</dt>
            <dd>
              <span class="text-xl font-bold text-slate-900">3</span> formats: PDF · Excel · Word
            </dd>
          </div>
        </dl>
        <nav class="mt-8 flex flex-wrap justify-center gap-2" aria-label="Template categories">
          {
            groups.map((g) => (
              <a
                href={`#${g.key}`}
                class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-sm font-medium text-slate-600 hover:border-brand-300 hover:text-brand-700 transition-colors"
              >
                {g.title}
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-14">
      <a
        href="/tools/pay-app/"
        data-tool-callout="pay-app"
        class="group flex flex-col gap-4 rounded-2xl border border-brand-200 bg-brand-50 p-5 transition-all hover:border-brand-300 hover:shadow-sm sm:flex-row sm:items-center"
      >
        <span
          class="inline-flex shrink-0 items-center justify-center self-start rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-white"
        >
          New · Online tool
        </span>
        <span class="min-w-0 flex-1">
          <span class="block font-semibold text-slate-900"
            >Build your pay application in the browser</span
          >
          <span class="mt-0.5 block text-sm text-slate-600">
            Schedule of values, retainage and the monthly roll-forward done for you, then a filled
            G702/G703-style PDF. Saves in your browser, no email.
          </span>
        </span>
        <span class="text-sm font-semibold text-brand-700 group-hover:underline"
          >Open the builder</span
        >
      </a>
      <p class="mt-3 text-sm text-slate-600">
        Need quantities first? The
        <a href="/tools/drywall-calculator/" class="font-semibold text-brand-700 hover:underline"
          >drywall calculator</a
        > and the rest of our
        <a href="/tools/" class="font-semibold text-brand-700 hover:underline">free tools</a> build an
        estimate as you go, and the
        <a href="/prices/" class="font-semibold text-brand-700 hover:underline"
          >material price trends</a
        > show how lumber, concrete, steel and copper wire have moved before you price them.
      </p>
    </section>

    {
      groups.map((g) => (
        <section id={g.key} class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 scroll-mt-28">
          <div class="mb-6">
            <h2 class="text-2xl font-bold text-slate-900 tracking-tight">{g.title}</h2>
            <p class="mt-1 text-slate-500">{g.blurb}</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {g.items.map((t) => {
              const m = manifest[t.slug];
              const pv = m?.previews?.[0];
              const live = !!m;
              return (
                <a
                  href={`/templates/${t.slug}/`}
                  class="group flex flex-col rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md hover:border-brand-200 transition-all"
                >
                  <div class="bg-slate-50 border-b border-slate-100 p-3">
                    {pv ? (
                      <picture>
                        <source srcset={`/templates-previews/${pv.webp}`} type="image/webp" />
                        <img
                          src={`/templates-previews/${pv.file}`}
                          alt={`${t.title} — preview`}
                          width={pv.width}
                          height={pv.height}
                          loading="lazy"
                          decoding="async"
                          class="w-full h-40 object-cover object-top rounded-lg border border-slate-200 bg-white"
                        />
                      </picture>
                    ) : (
                      <div class="h-40 rounded-lg border border-dashed border-slate-200 bg-white flex items-center justify-center text-xs text-slate-400">
                        Preview coming soon
                      </div>
                    )}
                  </div>
                  <div class="flex flex-col flex-1 p-5">
                    <div class="flex items-center justify-between gap-3 mb-2">
                      <span class="inline-flex text-[11px] font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">
                        {live ? 'Free download' : 'Coming soon'}
                      </span>
                      <span class="text-[11px] font-semibold tracking-wide text-slate-400">
                        {t.formats.join(' · ')}
                      </span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
                      {t.title}
                    </h3>
                    <p class="mt-1.5 text-sm text-slate-500 leading-relaxed flex-1">{t.short}</p>
                    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
                      Get the template <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))
    }

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="rounded-2xl border border-slate-200 bg-white px-8 py-10 sm:px-12">
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight text-balance">
          Built like the documents BuildWorkPro produces
        </h2>
        <p class="mt-3 text-slate-500 leading-relaxed">
          Every template here is generated from the same document design our software uses for the
          bids, change orders, invoices, pay applications and daily reports it sends on behalf of
          subcontractors — the same type, the same table grammar, the same signature blocks. Each
          one comes with a completed example on a realistic job so you can see what a finished
          document looks like before you fill in your own. They are checked on real work at <a
            href="/customers/national-glass/"
            class="font-semibold text-brand-600 hover:underline">our founder's glazing company</a
          >, and when we improve a template every format is rebuilt together.
        </p>
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 px-8 py-10 sm:px-12">
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight text-balance">
          Want the whole set?
        </h2>
        <p class="mt-3 text-slate-500 leading-relaxed">
          Every template above is a free, direct download — no email needed. If you'd rather get
          everything at once, we'll email the download links to this address. One-time message, not
          a newsletter — we don't add you to a marketing list.
        </p>
        <form id="template-pack-form" class="mt-6 space-y-4">
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="email"
              name="email"
              required
              placeholder="you@company.com"
              aria-label="Email address"
              class="flex-1 px-4 py-2.5 rounded-lg border border-slate-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            />
            <button
              type="submit"
              id="template-pack-submit"
              class="px-6 py-2.5 rounded-lg bg-brand-600 text-white font-semibold text-sm hover:bg-brand-700 transition-colors whitespace-nowrap"
            >
              Email me the pack
            </button>
          </div>
          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="template-pack-consent"
              required
              class="mt-0.5 h-4 w-4 rounded border-slate-200 text-brand-600 focus:ring-2 focus:ring-brand-500"
            />
            <label for="template-pack-consent" class="text-sm text-slate-600">
              I agree to the processing of my personal data as described in the <a
                href="/privacy/"
                class="text-brand-600 hover:text-brand-700 font-medium underline">Privacy Policy</a
              >.
            </label>
          </div>
          <div id="template-pack-turnstile"></div>
          <div id="template-pack-status" class="hidden text-sm rounded-lg px-4 py-3"></div>
        </form>
      </div>
    </section>

    <FAQSection faqs={faqs} heading="Questions about the templates" />

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="rounded-2xl bg-slate-900 px-8 py-12 sm:px-14">
        <h2 class="text-2xl font-extrabold text-white tracking-tight text-balance">
          Or stop filling out templates altogether
        </h2>
        <p class="mt-3 text-slate-400 max-w-xl mx-auto">
          BuildWorkPro generates bids, pay applications, change orders, invoices and daily reports
          from your project data — $79/month flat, unlimited users.
        </p>
        <a
          href={config.signupUrl}
          class="mt-6 inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
        >
          Start free trial
        </a>
        <p class="mt-6 text-sm text-slate-500">
          Evaluating software?
          <a href="/compare/" class="text-slate-300 underline hover:text-white"
            >See how BuildWorkPro compares with Procore, Buildertrend and other construction
            software</a
          >.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  declare const turnstile: any;

  function initTemplatePackForm() {
    const form = document.getElementById('template-pack-form') as HTMLFormElement | null;
    const status = document.getElementById('template-pack-status');
    const submitBtn = document.getElementById('template-pack-submit') as HTMLButtonElement | null;
    const container = document.getElementById('template-pack-turnstile');
    if (!form || !status || !submitBtn || !container) return;

    const sitekey = document.body.dataset.turnstileSitekey;
    let turnstileToken = '';
    let widgetId: string | undefined;

    function renderWidget() {
      if (typeof turnstile === 'undefined' || widgetId !== undefined) return;
      widgetId = turnstile.render(container, {
        sitekey,
        callback: (token: string) => {
          turnstileToken = token;
        },
        'expired-callback': () => {
          turnstileToken = '';
        },
        theme: 'light',
      });
    }

    // Render when Turnstile script loads (may already be loaded)
    if (typeof turnstile !== 'undefined') renderWidget();
    else window.addEventListener('load', renderWidget);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!turnstileToken) {
        status.textContent = 'Please complete the verification above.';
        status.className =
          'text-sm rounded-lg px-4 py-3 bg-amber-50 text-amber-700 border border-amber-200';
        return;
      }

      const fd = new FormData(form);
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      status.className = 'hidden';

      try {
        const res = await fetch('/api/template-pack/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: fd.get('email'),
            'cf-turnstile-response': turnstileToken,
          }),
        });

        if (!res.ok) throw new Error();

        // Same conversion pair as the contact form; the form param separates
        // them in GA4. No-ops for whichever tracker hasn't loaded.
        (window as any).bwpTrack?.(
          { name: 'Lead' },
          { name: 'generate_lead', params: { form: 'template-pack' } }
        );

        status.textContent = 'Sent! Check your inbox for the download links.';
        status.className =
          'text-sm rounded-lg px-4 py-3 bg-green-50 text-green-700 border border-green-200';
        form.reset();
        turnstileToken = '';
        if (widgetId !== undefined) turnstile.reset(widgetId);
      } catch {
        status.textContent =
          'Something went wrong. Every template is also a free download on this page.';
        status.className =
          'text-sm rounded-lg px-4 py-3 bg-red-50 text-red-700 border border-red-200';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Email me the pack';
      }
    });
  }

  initTemplatePackForm();
  document.addEventListener('astro:page-load', initTemplatePackForm);
</script>
