---
// Page 3 of the /templates/ hub (issue #134). Canonical-map note: this page
// targets "schedule of values template" (480/mo KD0, navigational); the head
// term "schedule of values" (1,900/mo KD0, informational) stays canonical on
// /blog/schedule-of-values-guide/, which now links here for the download.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { config } from '../../config';

const FILE = '/templates-files/schedule-of-values-template.xlsx';

const whatsInside = [
  '30-row schedule with item number, description, value, and notes',
  '% of Contract column computed against your contract sum',
  'A check row that must hit 0.00 — the SOV always ties to the contract',
  'Six sample rows showing a real trade breakdown (overwrite them)',
  'Tips sheet: phasing, defensible values, front-loading, closeout lines',
  'Feeds straight into a G702/G703-style pay application',
];

const faqs = [
  {
    question: 'What is a schedule of values?',
    answer:
      'A schedule of values (SOV) breaks a construction contract sum into line items — mobilization, rough-in, trim, closeout — each with a dollar value. It is the backbone of progress billing: every month you bill a percentage of each line, and the SOV keeps score across the life of the job.',
  },
  {
    question: 'How many line items should a schedule of values have?',
    answer:
      'Enough that every line is independently verifiable on a walkthrough, and no more. For a typical trade subcontract that lands between 6 and 25 lines. Match the lines to how the work actually phases — a line you cannot demonstrate progress on is a line the GC will argue about.',
  },
  {
    question: 'Should I split labor and material in the SOV?',
    answer:
      'When the GC allows it, yes — separate labor and material lines let you bill stored materials before installation and make each line easier to defend. The sample rows in the template show the pattern.',
  },
  {
    question: 'Can I front-load a schedule of values?',
    answer:
      'Weighting early activities like mobilization and general conditions is common and generally accepted in moderation — but an obviously inflated early line invites a rejected application and sours the GC relationship. The rule: every value should survive you walking the GC through the site.',
  },
  {
    question: 'How does the SOV relate to my pay applications?',
    answer:
      'Every pay application bills against the SOV line by line: work completed this period, materials stored, total to date, retainage. Pair this template with our free G702/G703-style pay application template — or let BuildWorkPro build the SOV from your accepted bid and carry it forward every billing period automatically.',
  },
];
---

<Layout
  title="Free Schedule of Values Template (Excel)"
  description="Free schedule of values template for construction: 30-row Excel worksheet with % of contract math, a tie-out check, and sample trade line items. No email required."
>
  <Header />
  <main class="pt-32 pb-20">
    <!-- Hero -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
          Free template
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
          Schedule of Values Template
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          A clean Excel SOV that always ties out: line items, % of contract computed for you, and a
          check row that catches the math before your GC does.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={FILE}
            download
            data-template="schedule-of-values"
            class="template-download inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Download the free template (.xlsx)
          </a>
          <a
            href="/blog/schedule-of-values-guide/"
            class="inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm hover:border-brand-300 hover:text-brand-700 transition-colors"
          >
            Read the how-to guide
          </a>
        </div>
        <p class="mt-3 text-center text-sm text-slate-500">
          No email required · Works in Excel, Google Sheets &amp; Numbers
        </p>
      </div>
    </section>

    <!-- What's inside -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">
        What's in the worksheet
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          whatsInside.map((item) => (
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-brand-600 mt-0.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-600">{item}</span>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-slate-500 text-center max-w-2xl mx-auto">
        Building the SOV is step one — billing against it every month is the grind. Pair this with
        the
        <a
          href="/templates/aia-g702-g703/"
          class="text-brand-600 underline underline-offset-2 font-medium"
          >free G702/G703-style pay application template</a
        >, which carries these line items through every billing period.
      </p>
    </section>

    <FAQSection faqs={faqs} />

    <!-- CTA -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-20">
      <div class="rounded-2xl bg-slate-900 px-8 py-14 sm:px-14">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight text-balance">
          Your bid already knows the schedule of values
        </h2>
        <p class="mt-4 text-slate-400 max-w-xl mx-auto">
          BuildWorkPro seeds the SOV from your accepted bid, keeps it tied to the contract sum plus
          approved change orders, and bills against it every period — no spreadsheet reconciliation.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={config.signupUrl}
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <a
            href="/features/pay-applications/"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-white/10 text-white font-semibold text-sm hover:bg-white/20 transition-colors"
          >
            See pay applications in BuildWorkPro
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-500">
          <a href="/pricing/" class="text-slate-300 underline hover:text-white">$79/month flat</a> · 14-day
          free trial · No credit card required
        </p>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    document.querySelectorAll('.template-download').forEach(function (el) {
      el.addEventListener('click', function () {
        if (window.bwpTrack)
          window.bwpTrack(null, {
            name: 'template_download',
            params: { template: el.dataset.template },
          });
      });
    });
  </script>
</Layout>
