---
// Page 2 of the /templates/ hub (issue #134): the subcontractor-agreement
// cluster — ~5,600 searches/mo across 30+ variants, KD 0, a SERP of
// institutional PDFs (nyc.gov, sec.gov, university uploads) with no AI
// Overview. Ungated download per the Q5 decision.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { config } from '../../config';

const FILE = '/templates-files/subcontractor-agreement-template.docx';

const whatsInside = [
  'Scope of work with express exclusions',
  'Contract documents & order of precedence',
  'Progress payments, retainage, and G702-style billing terms',
  'Written-change-order clause that protects your margin',
  'Insurance, licenses, warranty, and indemnification',
  'Lien waiver exchange, termination, and disputes',
  'Signature blocks plus exhibits for drawings and the schedule of values',
];

const faqs = [
  {
    question: 'What should a subcontractor agreement include?',
    answer:
      'At minimum: the scope of work with exclusions, the subcontract price, payment terms including retainage and a billing schedule, a written change-order requirement, the project schedule, insurance requirements, warranty terms, indemnification, lien waiver procedure, and how disputes are resolved. This template covers all fourteen standard sections with bracketed fill-ins.',
  },
  {
    question: 'Is a subcontractor agreement legally binding?',
    answer:
      'Yes — once both parties sign, it is an enforceable contract. That is exactly why the change-order and payment clauses matter: they make the paper trail, not memory, control what you are owed. Have an attorney review any agreement before you rely on it; retainage limits, prompt-payment rules, and lien waiver forms vary by state.',
  },
  {
    question: 'Who provides the agreement — the GC or the sub?',
    answer:
      'On commercial work the general contractor usually issues their subcontract form, and you negotiate from it. This template is for the other cases: direct-to-owner jobs, smaller GCs without paper, and your own sub-tier subcontractors. Reading a standard form also makes you a sharper negotiator of a GC-issued one.',
  },
  {
    question: 'What is the difference between a subcontractor agreement and a purchase order?',
    answer:
      'A purchase order buys materials or a narrow, fixed deliverable; a subcontractor agreement governs ongoing labor on a project — scope, schedule, progress billing, retainage, changes, insurance, and warranty. If your work is billed monthly against a schedule of values, you want a subcontract, not a PO.',
  },
  {
    question: 'Can I sign it electronically?',
    answer:
      'Yes — properly executed e-signatures are legally binding in the United States under the federal ESIGN Act. BuildWorkPro includes built-in legally-binding e-signatures: send a bid or change order and your customer signs from an emailed link, with the certified signed PDF filed back on the record automatically.',
  },
];
---

<Layout
  title="Free Subcontractor Agreement Template (Word)"
  description="Free subcontractor agreement template for construction: 14 standard sections — scope, retainage, change orders, lien waivers — as an editable Word doc. No email required."
>
  <Header />
  <main class="pt-32 pb-20">
    <!-- Hero -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
          Free template
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
          Subcontractor Agreement Template
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          A 14-section standard-form subcontract as an editable Word document — scope, retainage,
          written change orders, lien waivers, and the payment terms that get subs paid on time.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={FILE}
            download
            data-template="subcontractor-agreement"
            class="template-download inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Download the free template (.docx)
          </a>
          <a
            href="/templates/"
            class="inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm hover:border-brand-300 hover:text-brand-700 transition-colors"
          >
            See all free templates
          </a>
        </div>
        <p class="mt-3 text-center text-sm text-slate-500">
          No email required · Opens in Word &amp; Google Docs
        </p>
      </div>
    </section>

    <!-- What's inside -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">
        What the agreement covers
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          whatsInside.map((item) => (
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-brand-600 mt-0.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-600">{item}</span>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-slate-500 text-center max-w-2xl mx-auto">
        The two clauses that earn their keep: <strong class="text-slate-700"
          >written change orders only</strong
        > (a verbal OK is not a change order) and <strong class="text-slate-700"
          >G702-style progress billing with retainage</strong
        > — the billing rhythm this template shares with our
        <a
          href="/templates/aia-g702-g703/"
          class="text-brand-600 underline underline-offset-2 font-medium"
          >free pay application template</a
        >.
      </p>
    </section>

    <FAQSection faqs={faqs} />

    <!-- CTA -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-20">
      <div class="rounded-2xl bg-slate-900 px-8 py-14 sm:px-14">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight text-balance">
          The contract is step one. Getting paid against it is the job.
        </h2>
        <p class="mt-4 text-slate-400 max-w-xl mx-auto">
          BuildWorkPro runs the rest of the loop this agreement describes: bids with legally-binding
          e-signatures, written change orders your customer approves online, and G702-style pay
          applications with retainage handled.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={config.signupUrl}
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <a
            href="/features/construction-bidding/"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-white/10 text-white font-semibold text-sm hover:bg-white/20 transition-colors"
          >
            See bids &amp; e-signatures
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-500">
          <a href="/pricing/" class="text-slate-300 underline hover:text-white">$79/month flat</a> · 14-day
          free trial · No credit card required
        </p>
      </div>
      <p class="mt-8 text-xs text-slate-400 max-w-2xl mx-auto">
        Not legal advice. This template is a general-purpose starting point; construction contract
        requirements — retainage limits, prompt-payment rules, lien waiver forms, indemnity
        restrictions — vary by state. Have a licensed attorney review before use.
      </p>
    </section>
  </main>
  <Footer />

  <script is:inline>
    document.querySelectorAll('.template-download').forEach(function (el) {
      el.addEventListener('click', function () {
        if (window.bwpTrack)
          window.bwpTrack(null, {
            name: 'template_download',
            params: { template: el.dataset.template },
          });
      });
    });
  </script>
</Layout>
