import TemplatePage from '../../components/templates/TemplatePage.astro';

const faqs = [
  {
    question: 'What is a letter of intent in construction?',
    answer:
      'A letter from a general contractor (or owner) telling a subcontractor it intends to award them a scope of work at a stated price, before the formal subcontract is ready. It lets the sub hold its price, reserve crews and start long-lead work such as submittals and equipment orders, while the lawyers finish the subcontract.',
  },
  {
    question: 'Is a construction letter of intent legally binding?',
    answer:
      'It depends on what it says and how the parties act on it, and courts in different states treat LOIs differently. A well-drafted LOI says clearly which parts are binding — usually the early-work authorization and payment for it — and that everything else is a statement of intent only. This template does that in paragraph 1, but have an attorney review before relying on it.',
  },
  {
    question: 'What is a not-to-exceed amount in a letter of intent?',
    answer:
      'The cap on what the GC will pay for early work if the formal subcontract is never signed. The sub is paid its documented cost, plus the markup in its bid, up to that amount, and any work beyond it needs a written increase. A cap protects both sides: the GC’s exposure is known, and the sub knows exactly how much work is covered.',
  },
  {
    question: 'What is the difference between a letter of intent and a notice to proceed?',
    answer:
      'A letter of intent comes before the subcontract and says “we intend to contract with you.” A notice to proceed comes after the subcontract is signed and says “start the work now” — it fixes the date the contract time begins. On most jobs the sequence is bid, letter of intent, subcontract, notice to proceed.',
  },
  {
    question: 'Should a subcontractor start work on a letter of intent?',
    answer:
      'Only the work the letter expressly authorizes, and only up to the not-to-exceed amount. Submittals, shop drawings and long-lead purchase orders are typical; site work usually is not. Anything beyond that is at your risk until the subcontract is signed or the GC raises the cap in writing.',
  },
  {
    question: 'How long is a letter of intent valid?',
    answer:
      'As long as it says. This template has two dates: the date the sub must accept the letter by, and the date the formal subcontract must be signed by. If either passes, the letter lapses unless both parties extend it in writing — so nobody is left holding a price or an award indefinitely.',
  },
];
