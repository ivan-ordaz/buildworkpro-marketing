---
// Page 5 of the /templates/ hub (issue #134): the proposal/bid-template
// cluster — construction proposal template 1,300/mo KD2 + construction bid
// template 720/mo KD0 + free variants, one canonical page. Ungated per Q5.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { config } from '../../config';

const FILE = '/templates-files/construction-bid-proposal-template.docx';

const whatsInside = [
  'Proposal header with number, date, and a pricing-valid-until field',
  'Scope of work section written to survive "while you\'re here" requests',
  'Price table with base bid, alternates, and allowances',
  'Inclusions AND exclusions sections — the paragraph that saves disputes',
  'Terms: price validity, progress payments with retainage, written change orders',
  'Acceptance signature block that turns the proposal into an agreement',
];

const faqs = [
  {
    question: 'What should a construction bid proposal include?',
    answer:
      'A clear scope of work, the price (with alternates broken out), what is included, what is excluded, the terms — how long the price holds, how you get paid, how changes are handled — and an acceptance signature block. The exclusions list is the most valuable paragraph: every exclusion you name is a dispute you never have.',
  },
  {
    question: 'What is the difference between a bid and a proposal?',
    answer:
      'A bid is usually a price submitted into a competitive selection — often to a GC, against drawings and specs. A proposal is the fuller document around that price: scope, inclusions, exclusions, terms, and an acceptance line. This template is the proposal wrapper; pair it with our free estimate template for the math behind the number.',
  },
  {
    question: 'Should I show one lump sum or itemized pricing?',
    answer:
      'Lead with the lump sum and break out alternates and allowances separately. Full line-item transparency invites line-item shopping; a single defensible number with clearly-priced alternates keeps the negotiation on scope, not on your unit costs.',
  },
  {
    question: 'How long should my pricing stay valid?',
    answer:
      'Thirty days is common; volatile material markets argue for less. The template carries a valid-until field and an escalation clause so an old proposal cannot bind you to old prices.',
  },
  {
    question: 'Can the client sign the proposal electronically?',
    answer:
      'Yes — e-signatures are legally binding in the United States under the ESIGN Act. BuildWorkPro sends your bid for legally-binding e-signature from an emailed link, chases the reminders, files the certified signed PDF on the record, and converts the accepted bid straight into a project.',
  },
];
---

<Layout
  title="Free Construction Bid Proposal Template (Word)"
  description="Free construction bid proposal template: scope, price with alternates, inclusions/exclusions, terms, and an acceptance block — an editable Word doc, no email required."
>
  <Header />
  <main class="pt-32 pb-20">
    <!-- Hero -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
          Free template
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
          Construction Bid Proposal Template
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          The proposal wrapper around your number: scope, price with alternates, the
          inclusions/exclusions lists that prevent disputes, and an acceptance block that makes the
          win official.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={FILE}
            download
            data-template="construction-bid-proposal"
            class="template-download inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Download the free template (.docx)
          </a>
          <a
            href="/blog/how-to-create-construction-bid/"
            class="inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm hover:border-brand-300 hover:text-brand-700 transition-colors"
          >
            Read the bidding guide
          </a>
        </div>
        <p class="mt-3 text-center text-sm text-slate-500">
          No email required · Opens in Word &amp; Google Docs
        </p>
      </div>
    </section>

    <!-- What's inside -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">
        What the proposal covers
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          whatsInside.map((item) => (
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-brand-600 mt-0.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-600">{item}</span>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-slate-500 text-center max-w-2xl mx-auto">
        The number inside the proposal comes from the
        <a
          href="/templates/construction-estimate/"
          class="text-brand-600 underline underline-offset-2 font-medium"
          >free construction estimate template</a
        > — material/labor split, overhead, and true-margin pricing.
      </p>
    </section>

    <FAQSection faqs={faqs} />

    <!-- CTA -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-20">
      <div class="rounded-2xl bg-slate-900 px-8 py-14 sm:px-14">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight text-balance">
          Send it, sign it, start the job
        </h2>
        <p class="mt-4 text-slate-400 max-w-xl mx-auto">
          BuildWorkPro builds the bid from your catalog, exports the client-ready PDF, collects the
          legally-binding e-signature, and converts the accepted bid into a project — reminders
          included.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={config.signupUrl}
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <a
            href="/features/construction-bidding/"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-white/10 text-white font-semibold text-sm hover:bg-white/20 transition-colors"
          >
            See bidding in BuildWorkPro
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-500">
          <a href="/pricing/" class="text-slate-300 underline hover:text-white">$79/month flat</a> · 14-day
          free trial · No credit card required
        </p>
      </div>
      <p class="mt-8 text-xs text-slate-400 max-w-2xl mx-auto">
        Not legal advice — have your attorney review the terms before relying on them.
      </p>
    </section>
  </main>
  <Footer />

  <script is:inline>
    document.querySelectorAll('.template-download').forEach(function (el) {
      el.addEventListener('click', function () {
        if (window.bwpTrack)
          window.bwpTrack(null, {
            name: 'template_download',
            params: { template: el.dataset.template },
          });
      });
    });
  </script>
</Layout>
