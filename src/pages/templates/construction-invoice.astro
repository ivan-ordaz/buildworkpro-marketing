---
// Construction invoice template — construction invoice template 1,300/mo KD0 + subcontractor invoice template 110/mo. Ungated per Q5.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { config } from '../../config';

const FILE = '/templates-files/construction-invoice-template.xlsx';

const whatsInside = [
  '15 line items with quantity × rate amounts computed per line',
  'Subtotal, adjustable sales-tax rate, and total due',
  'Invoice number, date, due date, and terms fields',
  'Payment-instructions block: checks, ACH, late-fee terms',
  'Sample service-work rows showing the pattern',
  'A pointer to the pay-app template when the client is a GC',
];

const faqs = [
  {
    question: 'What should a construction invoice include?',
    answer:
      'Your business details and license number, the client and project, an invoice number and date, line items with quantities and rates, tax where applicable, the total due, the due date, and how to pay. Ambiguity delays payment — the template fields exist so nothing is left to interpretation.',
  },
  {
    question: 'What is the difference between an invoice and a pay application?',
    answer:
      'An invoice bills a complete amount for work or service — common for direct-to-owner and service work. A pay application bills a percentage of progress against a schedule of values with retainage, on a monthly cycle — the format GCs require. If your client is a GC, you almost certainly need the pay application template instead.',
  },
  {
    question: 'What payment terms should I use?',
    answer:
      'Net 15 or Net 30 are standard; shorter for service work. State the due date as a date, not just a term, and include a late-fee percentage where your state allows it — an invoice with consequences gets prioritized.',
  },
  {
    question: 'How should I number invoices?',
    answer:
      'Sequentially, with a scheme that sorts: year plus a running number (2026-041) or a project prefix. Never reuse or skip numbers — your bookkeeper, your accountant, and any audit will thank you.',
  },
];
---

<Layout
  title="Free Construction Invoice Template (Excel)"
  description="Free construction invoice template: line items with computed amounts, sales tax, total due, and payment terms — an Excel workbook, no email required."
>
  <Header />
  <main class="pt-32 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
          Free template
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
          Construction Invoice Template
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          A clean invoice that does its own math: line items, tax, total due, and the payment terms
          that get you paid on time — for the work you bill directly, not through a GC.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={FILE}
            download
            data-template="construction-invoice"
            class="template-download inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Download the free template (.xlsx)
          </a>
          <a
            href="/templates/aia-g702-g703/"
            class="inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm hover:border-brand-300 hover:text-brand-700 transition-colors"
          >
            Billing a GC? Use the pay app template
          </a>
        </div>
        <p class="mt-3 text-center text-sm text-slate-500">
          No email required · Works in Excel, Google Sheets &amp; Numbers
        </p>
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">
        What's in the template
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          whatsInside.map((item) => (
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-brand-600 mt-0.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-600">{item}</span>
            </div>
          ))
        }
      </div>
      <p
        class="mt-8 text-sm text-slate-500 text-center max-w-2xl mx-auto"
        set:html={`Billing monthly against a schedule of values? That’s a <a href="/templates/aia-g702-g703/" class="text-brand-600 underline underline-offset-2 font-medium">pay application</a>, not an invoice — grab that template instead.`}
      />
    </section>

    <FAQSection faqs={faqs} />

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-20">
      <div class="rounded-2xl bg-slate-900 px-8 py-14 sm:px-14">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight text-balance">
          Invoices that come from the job, not a blank file
        </h2>
        <p class="mt-4 text-slate-400 max-w-xl mx-auto">
          BuildWorkPro generates invoices from your projects and pay applications and syncs them to
          QuickBooks Online — numbering, records, and the books all agree.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={config.signupUrl}
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <a
            href="/features/pay-applications/"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-white/10 text-white font-semibold text-sm hover:bg-white/20 transition-colors"
          >
            See billing in BuildWorkPro
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-500">
          <a href="/pricing/" class="text-slate-300 underline hover:text-white">$79/month flat</a> · 14-day
          free trial · No credit card required
        </p>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    document.querySelectorAll('.template-download').forEach(function (el) {
      el.addEventListener('click', function () {
        if (window.bwpTrack)
          window.bwpTrack(null, {
            name: 'template_download',
            params: { template: el.dataset.template },
          });
        // Post-#125 the pixel runs by default for US visitors — downloads
        // become a retargeting audience (custom event; not a standard one).
        if (window.fbq)
          window.fbq('trackCustom', 'TemplateDownload', { template: el.dataset.template });
      });
    });
  </script>
</Layout>
