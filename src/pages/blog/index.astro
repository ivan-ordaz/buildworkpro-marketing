---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: 'job-costing-for-subcontractors',
    title: 'Job Costing for Subcontractors: A Complete Guide',
    date: 'August 21, 2026',
    excerpt:
      'What job costing is, how to track estimated vs. actual labor, materials, and overhead on every project, and how to use closed-job data to sharpen your next estimate.',
  },
  {
    slug: 'construction-project-closeout-checklist',
    title: 'Construction Project Closeout Checklist',
    date: 'August 18, 2026',
    excerpt:
      'A construction project closeout checklist for subcontractors: punch list, closeout documents, AIA G704, final pay application, lien waivers, and retainage release.',
  },
  {
    slug: 'punch-list-management-for-subcontractors',
    title: 'Punch List Management for Subcontractors',
    date: 'August 14, 2026',
    excerpt:
      'What a construction punch list is, how to create one before the GC walks, and how to track items through closeout to protect your retainage.',
  },
  {
    slug: 'prevailing-wage-certified-payroll',
    title: 'Prevailing Wage & Certified Payroll Basics for Subcontractors',
    date: 'August 11, 2026',
    excerpt:
      'What prevailing wage is, which projects require it, how certified payroll reporting works, and the hourly records every subcontractor needs to stay compliant.',
  },
  {
    slug: 'buildertrend-pricing',
    title: 'Buildertrend Pricing 2026: Cost, Plans & Quotes',
    date: 'August 10, 2026',
    excerpt:
      'Buildertrend pricing is quote-only in 2026. Approximate last-published plan costs, what each tier covered, and how the cost compares for subcontractors.',
  },
  {
    slug: 'procore-pricing-for-subcontractors',
    title: 'Procore Pricing & Cost 2026: What Subcontractors Pay',
    date: 'August 10, 2026',
    excerpt:
      'Procore pricing is quote-only in 2026. Approximate ACV cost ranges, what subcontractors actually pay, and how the cost compares to a flat rate.',
  },
  {
    slug: 'construction-daily-report-template',
    title: 'How to Write a Construction Daily Report: What to Include',
    date: 'July 31, 2026',
    excerpt:
      'What a construction daily report (or site log) is, what to record in each section, how to write entries that hold up in a dispute, and how to make daily logging a crew habit.',
  },
  {
    slug: 'bid-bonds-vs-performance-bonds',
    title: "Bid Bonds vs. Performance Bonds: A Sub's Guide",
    date: 'July 17, 2026',
    excerpt:
      'What bid bonds, performance bonds, and payment bonds are, when subcontractors need them, how to get bonded, and what the difference means for your bidding strategy.',
  },
  {
    slug: 'how-to-read-construction-plans-takeoff',
    title: 'How to Read Construction Plans & Do a Takeoff',
    date: 'June 30, 2026',
    excerpt:
      'How to read a construction plan set and perform a quantity takeoff as a subcontractor: the types of drawings, how to isolate your scope, and how to turn counts into a structured estimate.',
  },
  {
    slug: 'construction-lien-waivers-explained',
    title: 'Conditional vs. Unconditional Lien Waivers: How They Work',
    date: 'June 23, 2026',
    excerpt:
      'How construction lien waivers work: the four types, why conditional vs. unconditional matters, when each changes hands in the billing cycle, and the red flags to catch before you sign.',
  },
  {
    slug: 'retainage-construction-guide',
    title: 'Retainage in Construction: How It Works & How to Track It',
    date: 'June 16, 2026',
    excerpt:
      "Retainage in construction explained: what it is, how it's calculated, when it releases, and how subcontractors can track withheld funds across active jobs.",
  },
  {
    slug: 'construction-markup-vs-margin',
    title: 'Construction Markup vs. Margin: How to Price a Job',
    date: 'June 12, 2026',
    excerpt:
      "Markup and margin aren't the same, and confusing them costs subcontractors profit on every bid. The difference, the conversion formula, and how to price to your real margin.",
  },
  {
    slug: 'schedule-of-values-guide',
    title: 'What Is a Schedule of Values? How the SOV Drives Billing',
    date: 'June 11, 2026',
    excerpt:
      'What a schedule of values is, who approves it, how it changes over a job — change orders, reallocations, stored materials, closeout — and why it decides how fast you get paid.',
  },
  {
    slug: 'how-to-create-construction-bid',
    title: 'How to Bid a Construction Job: A 7-Step Guide for Subcontractors',
    date: 'March 15, 2026',
    excerpt:
      'How subcontractors bid a construction job: plans and specs, takeoff, burdened labor, materials, overhead and profit, a worked bid example, and the proposal that wins the work.',
  },
  {
    slug: 'aia-pay-application-guide',
    title: 'How the AIA Pay Application Process Works for Subcontractors',
    date: 'March 10, 2026',
    excerpt:
      'What the G702 and G703 each do, the monthly pencil-to-payment cycle, the backup GCs require, and the mistakes that send a pay application back.',
  },
  {
    slug: 'construction-change-order-management',
    title: 'Construction Change Order Management: Best Practices',
    date: 'March 5, 2026',
    excerpt:
      'Best practices for managing construction change orders. Learn documentation, pricing, approval workflows, and how to protect your margins as a subcontractor.',
  },
  {
    slug: 'subcontractor-vs-general-contractor-software',
    title: 'Construction Subcontractor Software vs General Contractor Software',
    date: 'February 20, 2026',
    excerpt:
      'Why subcontractors need different software than general contractors. Compare features, pricing, and workflows to find the right construction management tool.',
  },
  {
    slug: 'construction-crm-tips',
    title: 'Construction CRM: How to Build a Sales Pipeline That Wins More Bids',
    date: 'February 15, 2026',
    excerpt:
      'Construction CRM tips for subcontractors. Build a sales pipeline, track leads, improve follow-ups, and increase your bid win rate.',
  },
