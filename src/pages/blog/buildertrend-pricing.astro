// "buildertrend cost" are demonstrably winnable by low-authority sites —
// an entire micro-industry (buildertrendpricing.com, projul, costbench)
// ranks for them because Buildertrend stopped publishing prices in 2026.
// Figures framed as last-published / independently reported; re-verify
// before meaningful edits. Do not invent current quote amounts.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
