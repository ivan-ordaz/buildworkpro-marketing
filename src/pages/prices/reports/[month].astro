---
// /prices/reports/YYYY-MM/ — the monthly construction materials price report.
// Built entirely from the BLS data file as of that month, so a report never
// quotes a number that is not in the CSV beside it. Founder commentary, when
// written, comes from src/data/prices/commentary.ts.
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Sparkline from '../../../components/prices/Sparkline.astro';
import CiteBox from '../../../components/prices/CiteBox.astro';
import { COMMENTARY } from '../../../data/prices/commentary';
import { COMPOSITE, MATERIALS, REPORT_EXTRAS } from '../../../data/prices/materials';
import {
  addMonths,
  dollars,
  escalate,
  monthLabel,
  moved,
  pct,
  reportMonths,
  snapshot,
} from '../../../lib/prices/ppi';

export function getStaticPaths() {
  return reportMonths().map((month) => ({ params: { month }, props: { month } }));
}

const { month } = Astro.props as { month: string };
const label = monthLabel(month);
const prevLabel = monthLabel(addMonths(month, -1));
const yearAgo = addMonths(month, -12);
const yearAgoLabel = monthLabel(yearAgo);
const composite = snapshot(COMPOSITE, month);
// A series shared by two materials (sand and gravel sits under concrete and
// asphalt) is listed once, under the first.
const seen = new Set<string>();
const take = (ids: string[]) =>
  ids.filter((id) => !seen.has(id) && seen.add(id)).map((id) => snapshot(id, month));
const groups = [
  ...MATERIALS.map((m) => ({ name: m.name, href: `/prices/${m.slug}/`, rows: take(m.series) })),
  { name: 'Other materials', href: null, rows: take(REPORT_EXTRAS) },
].filter((g) => g.rows.length > 0);
const all = groups.flatMap((g) => g.rows);
const ranked = all.filter((r) => r.year != null).sort((a, b) => b.year! - a.year!);
const risers = ranked.filter((r) => r.year! > 0).slice(0, 3);
const fallers = ranked
  .filter((r) => r.year! < 0)
  .reverse()
  .slice(0, 3);
const bids = MATERIALS.map((m) => ({
  m,
  s: snapshot(m.headline, month),
  cost: escalate(m.headline, 10000, yearAgo, month),
}));
const note = COMMENTARY[month];
const preliminary = all.some((r) => r.preliminary);
const otherMonths = reportMonths().filter((p) => p !== month);
const changeClass = (n: number | null) =>
  n == null
    ? 'text-slate-400'
    : n > 0
      ? 'text-amber-700'
      : n < 0
        ? 'text-brand-700'
        : 'text-slate-600';
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const list = (rows: typeof ranked) =>
  rows
    .map((r) => `${lower(r.name)} (${pct(r.year)})`)
    .join(', ')
    .replace(/, ([^,]*)$/, ' and $1');

const citation = `BuildWorkPro, “Construction Materials Price Report: ${label}.” Data: U.S. Bureau of Labor Statistics, Producer Price Index. https://buildworkpro.com/prices/reports/${month}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `Construction Materials Price Report: ${label}`,
  author: { '@type': 'Organization', name: 'BuildWorkPro', url: 'https://buildworkpro.com/' },
  publisher: { '@type': 'Organization', name: 'BuildWorkPro', url: 'https://buildworkpro.com/' },
  about: 'Producer prices for construction materials',
  isBasedOn: 'https://www.bls.gov/ppi/',
  mainEntityOfPage: `https://buildworkpro.com/prices/reports/${month}/`,
};
---

<Layout
  title={`Construction Materials Price Report: ${label} | BuildWorkPro`}
  description={`Construction material prices ${moved(composite.year)} from ${yearAgoLabel} to ${label}. Lumber, concrete, steel, copper wire, drywall, glass, asphalt and roofing, with the data.`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header />
  <main class="pt-28 pb-20" data-report={month}>
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
        Monthly materials price report
      </p>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
        Construction materials prices: {label}
      </h1>
      <p class="mt-5 text-lg text-slate-600 leading-relaxed" data-lede>
        Producer prices for construction materials overall {moved(composite.year)} from {
          yearAgoLabel
        }
        and {moved(composite.month)} from {prevLabel}, according to the U.S. Bureau of Labor
        Statistics.{
          risers.length > 0 && ` Over the year the biggest increases were in ${list(risers)}.`
        }{fallers.length > 0 && ` The biggest declines were in ${list(fallers)}.`}
      </p>
      {
        preliminary && (
          <p class="mt-3 text-sm text-slate-500">
            {label} figures are preliminary. BLS revises each month four months after release, and
            this report updates with the revisions.
          </p>
        )
      }

      {
        note && (
          <section
            class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6"
            data-commentary
          >
            <h2 class="text-lg font-semibold text-slate-900">From the field</h2>
            <div class="mt-3 space-y-3 text-slate-700">
              {note.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            <p class="mt-3 text-sm text-slate-500">
              {note.author}, {note.role}
            </p>
          </section>
        )
      }

      <section class="mt-12">
        <h2 class="text-2xl font-bold text-slate-900">
          What a year of price changes does to a bid
        </h2>
        <p class="mt-2 text-slate-600">
          At producer prices, a $10,000 purchase in {yearAgoLabel} would cost this much in {label}.
        </p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            bids.map(({ m, s, cost }) => (
              <a
                href={`/prices/${m.slug}/`}
                class="rounded-2xl border border-slate-200 bg-white p-4 hover:border-brand-300"
                data-bid-card={m.slug}
              >
                <span class="block text-sm font-semibold text-slate-900">{m.name}</span>
                <span class="mt-1 block text-2xl font-bold tabular-nums text-slate-900">
                  {cost == null ? 'n/a' : dollars(cost)}
                </span>
                <span class={`block text-xs tabular-nums ${changeClass(s.year)}`}>
                  {pct(s.year)} vs. {yearAgoLabel}
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold text-slate-900">Every material we track</h2>
        <div class="mt-4 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
          <table class="w-full text-sm" data-report-table>
            <thead>
              <tr class="text-left text-xs uppercase tracking-wide text-slate-500">
                <th class="px-4 py-3 font-medium">Material</th>
                <th class="px-4 py-3 text-right font-medium">vs. {prevLabel}</th>
                <th class="px-4 py-3 text-right font-medium">vs. {yearAgoLabel}</th>
                <th class="px-4 py-3 font-medium">2 years</th>
              </tr>
            </thead>
            {
              groups.map((g) => (
                <tbody>
                  <tr class="bg-slate-50">
                    <th
                      colspan="4"
                      class="px-4 py-2 text-left text-xs font-semibold text-slate-700"
                    >
                      {g.href ? (
                        <a href={g.href} class="hover:underline">
                          {g.name}
                        </a>
                      ) : (
                        g.name
                      )}
                    </th>
                  </tr>
                  {g.rows.map((r) => (
                    <tr class="border-t border-slate-100" data-report-row={r.id}>
                      <td class="px-4 py-2.5 text-slate-800">{r.name}</td>
                      <td class={`px-4 py-2.5 text-right tabular-nums ${changeClass(r.month)}`}>
                        {pct(r.month)}
                      </td>
                      <td class={`px-4 py-2.5 text-right tabular-nums ${changeClass(r.year)}`}>
                        {pct(r.year)}
                      </td>
                      <td class="px-4 py-1.5">
                        <Sparkline id={r.id} asOf={month} />
                      </td>
                    </tr>
                  ))}
                </tbody>
              ))
            }
          </table>
        </div>
        <p class="mt-3 text-sm text-slate-500">
          Producer Price Index by commodity, not seasonally adjusted. Producer prices come before
          distribution and retail markups. <a
            href="/prices/methodology/"
            class="font-semibold text-brand-700 hover:underline">How these numbers are built</a
          >.
        </p>
      </section>

      <section class="mt-12">
        <CiteBox
          citation={citation}
          csvHref="/prices/data/all.csv"
          csvLabel="Download every series (CSV)"
        />
      </section>

      <section class="mt-12">
        <h2 class="text-xl font-bold text-slate-900">Use it on your next bid</h2>
        <p class="mt-2 text-slate-600">
          The <a href="/prices/" class="font-semibold text-brand-700 hover:underline"
            >material price pages</a
          > chart each material over two, five and ten years. The <a
            href="/tools/"
            class="font-semibold text-brand-700 hover:underline">free calculators</a
          > turn a room, a wall or a run of fence into quantities you can price, and the <a
            href="/templates/construction-estimate/"
            class="font-semibold text-brand-700 hover:underline">construction estimate template</a
          > lays them out for the customer.
        </p>
        <p class="mt-4 text-sm text-slate-600">
          <a href="/prices/reports/" class="font-semibold text-brand-700 hover:underline"
            >All monthly reports</a
          >
        </p>
        {
          otherMonths.length > 0 && (
            <p class="mt-4 text-sm text-slate-600">
              Earlier reports:{' '}
              {otherMonths.map((p, i) => (
                <>
                  {i > 0 && ', '}
                  <a
                    href={`/prices/reports/${p}/`}
                    class="font-semibold text-brand-700 hover:underline"
                  >
                    {monthLabel(p)}
                  </a>
                </>
              ))}
            </p>
          )
        }
      </section>
    </article>
  </main>
  <Footer />
</Layout>
