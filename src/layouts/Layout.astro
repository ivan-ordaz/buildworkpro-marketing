---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { config } from '../config';
import { TEMPLATES } from '../data/templates';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** 'article' for blog posts — anything else renders og:type website. */
  ogType?: 'website' | 'article';
}

const {
  title = 'BuildWorkPro - Construction Project Management & ERP Platform',
  description = 'The all-in-one platform for construction companies. Manage projects, contacts, quotes, billing, and your entire team from a single, powerful dashboard.',
  image = '/og-image.png',
  noindex = false,
  ogType = 'website',
} = Astro.props;

const ogImageUrl = new URL(image, Astro.site).href;

// Auto-generate BreadcrumbList JSON-LD from the URL path so feature/solution/
// compare/blog pages become rich-result eligible. Home is always first; each
// path segment becomes a crumb labeled from a known map (falls back to a
// Title-Cased version of the slug).
const breadcrumbLabels: Record<string, string> = {
  features: 'Features',
  solutions: 'Solutions',
  compare: 'Compare',
  lp: 'Landing',
  blog: 'Blog',
  templates: 'Templates',
  prices: 'Material Prices',
  reports: 'Reports',
  methodology: 'Methodology',
  tools: 'Free Tools',
  docs: 'Docs',
  api: 'API',
  security: 'Security',
  disclosure: 'Responsible Disclosure',
  about: 'About',
  contact: 'Contact',
  support: 'Support',
  integrations: 'Integrations',
  agents: 'Agents',
  developers: 'Developers',
  privacy: 'Privacy',
  terms: 'Terms',
  cookies: 'Cookies',
  'construction-crm': 'Construction CRM',
  'buildertrend-alternative': 'Buildertrend Alternative',
};

// Google prints crumb names in the result's URL line, so the slug fallback must
// keep acronyms intact ("Rfi", "Tm Ticket" and "Aia G702 G703" shipped before).
const breadcrumbAcronyms: Record<string, string> = {
  aia: 'AIA',
  api: 'API',
  crm: 'CRM',
  faq: 'FAQ',
  hvac: 'HVAC',
  jsa: 'JSA',
  rfi: 'RFI',
  sov: 'SOV',
  tm: 'T&M',
  g702: 'G702',
  g703: 'G703',
};

// Path segments that have no index page of their own (/customers/ and /lp/
// both 404; /tools/ got its hub page on 2026-10-08). A crumb pointing at one is invalid structured data, so it is
// skipped and the page hangs directly off its parent.
const segmentsWithoutHub = new Set(['customers', 'lp']);

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { name: 'Home', url: new URL('/', Astro.site).href },
  ...segments.flatMap((seg, i) => {
    const slug = seg.toLowerCase();
    const isLast = i === segments.length - 1;
    if (!isLast && segmentsWithoutHub.has(slug)) return [];
    // /prices/reports/2026-08/ → "August 2026" rather than "2026 08".
    const monthMatch = /^(\d{4})-(\d{2})$/.exec(slug);
    const monthTitle = monthMatch
      ? `${['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][Number(monthMatch[2]) - 1]} ${monthMatch[1]}`
      : undefined;
    const templateTitle =
      isLast && segments[0] === 'templates' && slug in TEMPLATES
        ? TEMPLATES[slug].title
        : undefined;
    const label =
      templateTitle ??
      monthTitle ??
      breadcrumbLabels[slug] ??
      slug
        .split('-')
        .map((word) => breadcrumbAcronyms[word] ?? word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
    const url = new URL(`/${segments.slice(0, i + 1).join('/')}/`, Astro.site).href;
    return [{ name: label, url }];
  }),
];

const showBreadcrumbs = breadcrumbItems.length > 1;

// Geo-gated consent default (issue #125) runs only in production builds. Under
// `astro dev`, a request to the /api/geo/ SSR route makes Vite re-optimize the
// SSR dep graph (astro_virtual-modules_middleware) and full-reload every open
// page, which destabilizes the whole Playwright chromium project. Preview
// (wrangler/workerd over the built output) and production have no Vite, so the
// flag is on there — the geo-consent specs run in the preview project.
const geoDefaultEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Must stay the first thing in <head>: the HTML spec only looks for a
         charset declaration in the first 1024 bytes, and the response carries
         no charset header. Behind the consent script below (~8.8 KB) it was
         missed, so crawlers decoded titles as mojibake ("—" → "â€”").
         Guarded by tests/seo-structure.spec.ts. -->
    <meta charset="utf-8" />
    <!-- Google Consent Mode v2. GA4 loads on EVERY page with consent
         default-denied, so it sends cookieless, anonymized pings (no cookies,
         no ad identifiers) for visitors who have not chosen yet. On Accept it
         upgrades to full measurement; on Decline it is fully disabled. The
         Meta Pixel has no cookieless mode, so it loads only on Accept. The
         consent default must run BEFORE the gtag.js loader so the first ping
         is scoped correctly. -->
    <script is:inline define:vars={{ geoDefaultEnabled }}>
      window.dataLayer = window.dataLayer || [];
      // CRITICAL: gtag must push the `arguments` object, exactly as in Google's
      // canonical snippet. gtag.js distinguishes an `arguments` object (a gtag
      // API command: consent/config/js/get) from a plain array (a generic
      // dataLayer event). A rest-param `(...args)` pushed as an array makes
      // gtag.js silently treat `consent`/`config` as events, so consent never
      // resolves and NO hit is ever sent — the property stays empty. Do NOT
      // "modernize" this to rest params (the eslint-disable below guards it).
      function gtag() {
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer.push(arguments);
      }
      // Consent Mode v2 — default-deny. `wait_for_update` gives the
      // CookieConsent banner ~500ms to update consent before any pings fire,
      // avoiding a denied ping followed immediately by a granted one.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      // Redact ad-click identifiers from requests while consent is denied, so
      // the default cookieless pings stay anonymous.
      gtag('set', 'ads_data_redaction', true);
      // Exposed so the CookieConsent component can flip consent on accept.
      window.bwpGrantAnalyticsConsent = function () {
        window['ga-disable-G-REK78NBR14'] = false;
        gtag('consent', 'update', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
          functionality_storage: 'granted',
          personalization_storage: 'granted',
        });
      };
      // Called on explicit Decline (and via "Cookie settings"). A decline is a
      // real opt-out: fully disable GA so not even cookieless pings are sent.
      window.bwpRevokeAnalyticsConsent = function () {
        window['ga-disable-G-REK78NBR14'] = true;
        gtag('consent', 'update', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'denied',
          personalization_storage: 'denied',
        });
        // If the Pixel was already loaded this pageview (geo-default posture),
        // stop it immediately; the stored decline keeps it from loading again.
        if (window.fbq) window.fbq('consent', 'revoke');
      };
      window.bwpLoadGA = function () {
        if (window.__bwpGALoaded) return;
        window.__bwpGALoaded = true;
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-REK78NBR14';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-REK78NBR14');
      };
      // Meta Pixel (Facebook) — loaded only on Accept. It has no cookieless
      // mode, so unlike GA4 it does NOT load by default and never loads on
      // decline. Pixel ID is a public client-side identifier (like the GA id).
      window.bwpLoadMetaPixel = function () {
        if (window.__bwpPixelLoaded) return;
        window.__bwpPixelLoaded = true;
        const n = function (...args) {
          if (n.callMethod) {
            n.callMethod(...args);
          } else {
            n.queue.push(args);
          }
        };
        window.fbq = n;
        if (!window._fbq) window._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = '2.0';
        n.queue = [];
        const t = document.createElement('script');
        t.async = true;
        t.src = 'https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(t);
        window.fbq('init', '689268612776537');
        window.fbq('track', 'PageView');
      };
      // Unified conversion-event tracker. GA4 is always loaded (cookieless
      // until consent), so GA events flow for every visitor; Meta events fire
      // only once the pixel has loaded (i.e. after Accept). Never throws:
      // analytics must never break the page.
      window.bwpTrack = function (meta, ga) {
        try {
          if (meta && window.fbq) window.fbq('track', meta.name, meta.params || {});
          if (ga && window.__bwpGALoaded) gtag('event', ga.name, ga.params || {});
        } catch {
          /* best-effort — swallow */
        }
      };
      // Apply any stored choice, then load. Four postures (issue #125):
      //  • Declined      → fully disable GA, load nothing.
      //  • Accepted      → grant consent + full GA + Meta Pixel.
      //  • No choice, EEA/UK/CH or unknown region → GA cookieless (default-deny);
      //    no pixel until Accept (opt-in, as before).
      //  • No choice, everywhere else (US target market) → opt-out posture:
      //    consent granted + pixel loads by default; Decline (banner or the
      //    footer "Cookie settings" link) revokes and is remembered.
      let bwpAccepted = false;
      let bwpDeclined = false;
      try {
        bwpAccepted = !!localStorage.getItem('bwp-cookies-accepted');
        bwpDeclined = !!localStorage.getItem('bwp-cookies-declined');
      } catch {
        /* localStorage unavailable (private browsing, SSR) — treat as no choice */
      }
      if (bwpDeclined) {
        window['ga-disable-G-REK78NBR14'] = true;
      } else if (bwpAccepted) {
        window.bwpGrantAnalyticsConsent();
        window.bwpLoadGA();
        window.bwpLoadMetaPixel();
      } else {
        window.bwpLoadGA();
        // Opt-in regions: EU/EEA member states + UK + Switzerland. Anything
        // outside the list defaults to measurement-on with opt-out. A missing
        // or failed lookup fails CLOSED to the opt-in posture.
        window.bwpApplyGeoDefault = function (country) {
          const optInRegions = [
            'AT',
            'BE',
            'BG',
            'HR',
            'CY',
            'CZ',
            'DK',
            'EE',
            'FI',
            'FR',
            'DE',
            'GR',
            'HU',
            'IE',
            'IS',
            'IT',
            'LI',
            'LV',
            'LT',
            'LU',
            'MT',
            'NL',
            'NO',
            'PL',
            'PT',
            'RO',
            'SK',
            'SI',
            'ES',
            'SE',
            'GB',
            'CH',
          ];
          if (!country || optInRegions.indexOf(country) !== -1) return;
          // Re-check: an Accept/Decline click may have landed while the geo
          // lookup was in flight — an explicit choice always wins.
          try {
            if (localStorage.getItem('bwp-cookies-declined')) return;
          } catch {
            /* unreadable → keep going, same as no choice */
          }
          window.bwpGrantAnalyticsConsent();
          window.bwpLoadMetaPixel();
        };
        // geoDefaultEnabled (define:vars) is false under `astro dev` — see the
        // frontmatter comment. Off means the pre-#125 opt-in behavior exactly.
        if (geoDefaultEnabled) {
          try {
            const cachedCountry = sessionStorage.getItem('bwp-geo');
            if (cachedCountry) {
              window.bwpApplyGeoDefault(cachedCountry);
            } else {
              fetch('/api/geo/')
                .then((r) => (r.ok ? r.json() : null))
                .then((d) => {
                  if (!d || !d.country) return;
                  try {
                    sessionStorage.setItem('bwp-geo', d.country);
                  } catch {
                    /* best-effort cache */
                  }
                  window.bwpApplyGeoDefault(d.country);
                })
                .catch(() => {
                  /* lookup failed → stay opt-in */
                });
            }
          } catch {
            /* sessionStorage unavailable → stay opt-in */
          }
        }
      }
    </script>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={Astro.url.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="BuildWorkPro" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Organization Schema -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': `${config.siteUrl}/#organization`,
        name: 'BuildWorkPro',
        url: config.siteUrl,
        logo: `${config.siteUrl}/logo.png`,
        contactPoint: {
          '@type': 'ContactPoint',
          email: config.email.support,
          contactType: 'customer support',
        },
        // Live third-party listings — entity-graph corroboration for a young
        // domain. Only profiles that actually exist; add new ones as they go
        // live (SourceForge is still pending review).
        sameAs: [
          'https://www.saashub.com/buildworkpro',
          'https://www.capterra.com/p/10048861/BuildWorkPro/',
          'https://www.g2.com/products/build-work-pro/reviews',
        ],
      })}
    />

    <!-- BreadcrumbList Schema (skipped on the homepage). -->
    {
      showBreadcrumbs && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: breadcrumbItems.map((item, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: item.name,
              item: item.url,
            })),
          })}
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer
    ></script>
    <title>{title}</title>
  </head>
  <body class="bg-white text-slate-900 font-sans" data-turnstile-sitekey={config.turnstileSiteKey}>
    <slot />
    <CookieConsent />

    <!-- Acquisition-attribution passthrough. Every "Start free trial" CTA
         renders config.signupUrl — a build-time constant with no query string —
         so an ad click's UTMs and click ids would die at the
         buildworkpro.com -> app.buildworkpro.com hop. Capture them on the
         landing page, hold them for the visit (visitors browse before they
         convert), and append them to the signup links. The app's signup page
         reads exactly these keys off its own query string and persists them on
         the new tenant; the server then rebuilds Meta's `fbc` click id from the
         forwarded fbclid. Without this hop, Meta receives conversions it cannot
         match to the ad that paid for them, which is why the ad account could
         only ever optimize for link clicks.

         Not consent-gated: this is first-party attribution on our own signup
         link. It sets no cookie, loads no tracker, carries no identifier of its
         own, and stores nothing unless an ad, a search engine or another site
         sent someone here (a direct visit stays completely clean). -->
    <script is:inline define:vars={{ signupUrl: config.signupUrl }}>
      (function () {
        // The keys the app reads, capped to its column widths so a crafted
        // long value becomes a clean truncation rather than a rejected signup.
        const FIELDS = {
          utm_source: 255,
          utm_medium: 255,
          utm_campaign: 255,
          utm_content: 255,
          utm_term: 255,
          fbclid: 512,
          gclid: 512,
          landing_page: 1024,
        };
        const STORAGE_KEY = 'bwp_attribution';

        // An attributed arrival: at least one attribution param in the URL.
        // landing_page is ours to synthesize — it is the page the ad pointed
        // at, not the page the visitor happens to convert from.
        function fromUrl() {
          const params = new URLSearchParams(location.search);
          const found = {};
          let any = false;
          for (const key in FIELDS) {
            if (key === 'landing_page') continue;
            const value = params.get(key);
            if (value) {
              found[key] = value.slice(0, FIELDS[key]);
              any = true;
            }
          }
          if (!any) return null;
          found.landing_page = location.pathname.slice(0, FIELDS.landing_page);
          return found;
        }

        // Search engines and AI assistants send visitors with no query params,
        // so without this an organic signup lands on the tenant with every
        // attribution column null and cannot be told apart from direct traffic.
        // Label them the way GA4 does. The referrer is only the origin (browsers
        // strip the path cross-origin), so the search query itself never leaves.
        const ORGANIC_HOSTS = {
          google: 'organic',
          bing: 'organic',
          duckduckgo: 'organic',
          yahoo: 'organic',
          ecosia: 'organic',
          brave: 'organic',
          chatgpt: 'ai-assistant',
          openai: 'ai-assistant',
          perplexity: 'ai-assistant',
          claude: 'ai-assistant',
          copilot: 'ai-assistant',
          gemini: 'ai-assistant',
        };

        function fromReferrer() {
          let host;
          try {
            host = new URL(document.referrer).hostname.replace(/^www\./, '');
          } catch {
            return null; // no referrer (direct) or an unparseable one
          }
          if (!host || host === location.hostname || host.endsWith('buildworkpro.com')) {
            return null; // internal navigation or the app itself
          }
          const labels = host.split('.');
          let medium = 'referral';
          let source = host;
          for (const name in ORGANIC_HOSTS) {
            if (labels.indexOf(name) !== -1) {
              medium = ORGANIC_HOSTS[name];
              source = name === 'openai' ? 'chatgpt' : name;
              break;
            }
          }
          return {
            utm_source: source.slice(0, FIELDS.utm_source),
            utm_medium: medium,
            landing_page: location.pathname.slice(0, FIELDS.landing_page),
          };
        }

        // sessionStorage can throw (private mode, blocked storage). Attribution
        // is best-effort — never let it break the page or the CTA.
        function remember(attribution) {
          try {
            sessionStorage.setItem(STORAGE_KEY, JSON.stringify(attribution));
          } catch {
            /* storage unavailable — this page's links still get decorated */
          }
        }

        function recall() {
          try {
            const raw = sessionStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : null;
          } catch {
            return null;
          }
        }

        // Rewrite the hrefs rather than patching them on click, so middle-click,
        // "open in new tab" and "copy link address" carry attribution too.
        // Appending a query string keeps signupUrl a PREFIX of the href, which
        // the conversion-event listener below relies on to spot a CTA.
        function decorate(attribution) {
          if (!attribution) return;
          const links = document.querySelectorAll('a[href^="' + signupUrl + '"]');
          for (let i = 0; i < links.length; i++) {
            const url = new URL(links[i].href);
            for (const key in FIELDS) {
              const value = attribution[key];
              // Only known keys, and never clobber a param already on the link.
              if (typeof value === 'string' && value && !url.searchParams.has(key)) {
                url.searchParams.set(key, value.slice(0, FIELDS[key]));
              }
            }
            links[i].href = url.toString();
          }
        }

        function run() {
          // Last touch wins: a fresh ad click supersedes an earlier one.
          const arriving = fromUrl();
          if (arriving) {
            remember(arriving);
            decorate(arriving);
            return;
          }
          // An organic arrival only fills an empty slot — it never overwrites
          // an ad touch from earlier in the visit, which is what paid budget
          // decisions are made on.
          const stored = recall();
          if (stored) {
            decorate(stored);
            return;
          }
          const organic = fromReferrer();
          if (organic) remember(organic);
          decorate(organic);
        }

        run();
        document.addEventListener('astro:page-load', run);
      })();
    </script>

    <!-- Conversion-event instrumentation (Meta Pixel + GA4). Runs on every
         page. GA4 events flow cookielessly for every visitor; Meta events fire
         only once the pixel loads on Accept (see bwpTrack in the head). -->
    <script is:inline define:vars={{ signupUrl: config.signupUrl }}>
      (function () {
        function track(meta, ga) {
          if (window.bwpTrack) window.bwpTrack(meta, ga);
        }

        // 1. Primary conversion: every "Start free trial" CTA points at
        //    config.signupUrl, so one delegated listener instruments all 40+
        //    of them. User-triggered, so it naturally post-dates consent.
        function onCtaActivate(e) {
          const a = e.target && e.target.closest && e.target.closest('a[href]');
          if (!a || a.href.indexOf(signupUrl) !== 0) return;
          track(
            {
              name: 'InitiateCheckout',
              params: { content_name: 'free_trial', content_category: 'signup' },
            },
            { name: 'start_trial', params: { cta_href: a.href } }
          );
        }
        document.addEventListener('click', onCtaActivate);
        document.addEventListener('auxclick', onCtaActivate); // middle-click → new tab

        // Template downloads (issue #145). GA fires cookielessly for every
        // visitor; the Meta custom event fires only when the pixel is loaded
        // (Accept, or the US geo-default). Standard Meta events don't fit a
        // file download, so this is trackCustom rather than bwpTrack's track.
        function onTemplateDownload(e) {
          const el = e.target && e.target.closest && e.target.closest('a.template-download');
          if (!el) return;
          const template = el.getAttribute('data-template') || '';
          if (window.bwpTrack)
            window.bwpTrack(null, {
              name: 'template_download',
              params: { template: template },
            });
          if (window.fbq) window.fbq('trackCustom', 'TemplateDownload', { template: template });
          revealNextStep(template);
        }

        // Post-download next step (template pages). The download itself is
        // never gated; this panel only appears once the file is on its way,
        // and only once per page view.
        function revealNextStep(template) {
          const panel = document.getElementById('template-next-step');
          if (!panel || !panel.hidden) return;
          panel.hidden = false;
          if (window.bwpTrack)
            window.bwpTrack(null, {
              name: 'template_next_step_view',
              params: { template: template },
            });
        }

        function onNextStepActivate(e) {
          const a = e.target && e.target.closest && e.target.closest('[data-next-step]');
          const panel = a && a.closest('#template-next-step');
          if (!panel || !window.bwpTrack) return;
          window.bwpTrack(null, {
            name: 'template_next_step_click',
            params: {
              template: panel.getAttribute('data-template') || '',
              target: a.getAttribute('data-next-step') || '',
            },
          });
        }
        document.addEventListener('click', onNextStepActivate);
        document.addEventListener('auxclick', onNextStepActivate);
        document.addEventListener('click', onTemplateDownload);
        document.addEventListener('auxclick', onTemplateDownload);

        // 2 & 3. High-intent page views, fired immediately on load. GA4
        //        captures them cookielessly for every visitor; Meta captures
        //        them only when the pixel is already loaded (returning accepters).
        (function () {
          // Feature detail pages (/features/<slug>/) — not the /features/ hub.
          const fm = location.pathname.match(/^\/features\/([^/]+)\/?$/);
          if (fm) {
            track(
              { name: 'ViewContent', params: { content_type: 'feature', content_name: fm[1] } },
              { name: 'view_feature', params: { feature: fm[1] } }
            );
          }

          // Compare pages (/compare/<slug>/) — not the /compare/ hub.
          // content_name drops the trailing -alternative so /compare/procore-alternative/
          // fires content_name: 'procore' (and the same for other competitors).
          const cm = location.pathname.match(/^\/compare\/([^/]+)\/?$/);
          if (cm) {
            const name = cm[1].replace(/-alternative$/, '');
            track(
              { name: 'ViewContent', params: { content_type: 'compare', content_name: name } },
              { name: 'view_compare', params: { compare: name } }
            );
          }

          // Ads landing pages (/lp/<slug>/). Hyphens → underscores so
          // /lp/procore-alternative/ fires content_name: 'procore_alternative'.
          const lm = location.pathname.match(/^\/lp\/([^/]+)\/?$/);
          if (lm) {
            const name = lm[1].replace(/-/g, '_');
            track(
              { name: 'ViewContent', params: { content_type: 'lp', content_name: name } },
              { name: 'view_lp', params: { lp: name } }
            );
          }

          // Pricing is a section (#pricing), not a route — fire once when it
          // first scrolls into view, a stronger intent signal than page load.
          const pricing = document.getElementById('pricing');
          if (pricing && 'IntersectionObserver' in window) {
            let fired = false;
            const io = new IntersectionObserver(
              function (entries) {
                for (let i = 0; i < entries.length; i++) {
                  if (entries[i].isIntersecting && !fired) {
                    fired = true;
                    io.disconnect();
                    track(
                      {
                        name: 'ViewContent',
                        params: { content_type: 'pricing', content_name: 'pricing' },
                      },
                      { name: 'view_pricing' }
                    );
                  }
                }
              },
              { threshold: 0.4 }
            );
            io.observe(pricing);
          }
        })();
      })();
    </script>
  </body>
</html>
